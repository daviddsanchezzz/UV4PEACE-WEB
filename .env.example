# Supabase (Project Settings → API). Both values are public-safe: the database enforces access with RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Contact form email (server-side only, never PUBLIC_). Resend: https://resend.com
# CONTACT_FROM (also used for newsletter emails) must be an address on a domain verified in Resend, e.g. UV4PEACE website <web@uv4peace.org>
RESEND_API_KEY=
CONTACT_FROM=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional: it can also be set in the panel (Ajustes).
# Without it there is no analytics and no cookie banner.
PUBLIC_GA_ID=
