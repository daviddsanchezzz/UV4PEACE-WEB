---
import Base from '../../layouts/Base.astro';
import ClassicPage from '../../components/classic/ClassicPage.astro';
import ProjectBlock from '../../components/classic/ProjectBlock.astro';
import { currentProjects, previousProjects } from '../../data/classic';
---
<Base title="Projects" current="projects">
  <ClassicPage title="Projects">
    <nav aria-label="Sections" class="mb-12 flex flex-wrap gap-2">
      <a href="#current" class="btn btn-tertiary btn-sm">Current projects</a>
      <a href="#previous" class="btn btn-tertiary btn-sm">Previous projects</a>
    </nav>
    <h2 id="current" class="t-h1 scroll-mt-24 text-navy">Current projects</h2>
    <div class="mt-10 flex flex-col gap-14">
      {currentProjects.map((p, i) => <ProjectBlock project={p} level="h3" flip={i % 2 === 1} />)}
    </div>
    <h2 id="previous" class="t-h1 mt-24 scroll-mt-24 border-t border-line pt-16 text-navy">Previous projects</h2>
    <div class="mt-10 flex flex-col gap-14">
      {previousProjects.map((p) => <ProjectBlock project={p} level="h3" />)}
    </div>
  </ClassicPage>
</Base>
