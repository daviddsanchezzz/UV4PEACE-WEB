---
export const prerender = false;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import PressStrip from '../components/PressStrip.astro';
import MediaCoverage from '../components/MediaCoverage.astro';
import { getSettings } from '../lib/content';
const settings = await getSettings();
// Content is read from Supabase on request; the CDN keeps each page for a minute so edits show up quickly without hitting the database on every visit.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---
<Base title="Press" current="press" description="Recognition, media coverage and press resources for United Voices 4 Peace.">
  <PageHeader eyebrow="Press room" title={['Recognised for', 'uniting communities']} />

  <section class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-start gap-[clamp(40px,6vw,96px)] pb-[clamp(72px,10vw,128px)]">
    <div>
      <h2 class="eyebrow text-ink-muted">Recognition</h2>
      <div class="mt-5"><PressStrip showFeaturedIn={false} /></div>
    </div>
    <aside class="flex flex-col gap-6">
      <figure class="relative m-0 aspect-[3/2] overflow-hidden rounded-card bg-placeholder">
        <Photo src="06-prensa-entrevista_IMG_5230.jpg" alt="Interview with the press at Global Women in Music 2026" sizes="(min-width:1024px) 600px, 100vw" loading="eager" />
      </figure>
      <div class="rounded-card bg-navy p-[clamp(28px,3vw,40px)] text-white">
        <div class="eyebrow text-sky">Press contact</div>
        <a href={`mailto:${settings.email}?subject=Press`} class="mt-3 block text-2xl text-white hover:text-sky">{settings.email}</a>
      </div>
    </aside>
  </section>

  <section class="bg-surface-soft">
    <div class="wrap section-y-sm">
      <MediaCoverage />
    </div>
  </section>
</Base>
