---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RichEditor from '../../../components/admin/RichEditor.astro';
import { connect, getNewsletter, listSubscribers, countByStatus, newsletterLabel } from '../../../lib/newsletter-db';

const id = Astro.params.id ?? 'nueva';
const c = connect(Astro.request, Astro.cookies);
const isNew = id === 'nueva';
const item = isNew ? null : await getNewsletter(c, id);
if (!isNew && !item) return Astro.redirect('/admin/newsletter/');
const confirmed = countByStatus(await listSubscribers(c)).confirmed;
const locked = item ? item.status !== 'draft' : false;
const q = Astro.url.searchParams;
const errors: Record<string, string> = {
  guardar: 'No se ha podido guardar. Inténtalo de nuevo.',
  confirmar: 'Marca la casilla de confirmación para enviar.',
  estado: 'Esta newsletter ya no está en borrador (puede que alguien la haya enviado ya).',
  vacia: 'Falta el asunto o el texto. Guarda la newsletter y vuelve a intentarlo.',
  sinsuscriptores: 'No hay suscriptores confirmados a quienes enviar.',
  cambio: `La lista de suscriptores ha cambiado (ahora hay ${q.get('ahora') ?? '?'} confirmados). Revisa el número y vuelve a confirmar.`,
  envio: 'El servicio de correo no ha aceptado el envío. La newsletter sigue como borrador.',
};
const error = q.get('error') ? errors[q.get('error')!] ?? 'Ha ocurrido un error.' : '';
---
<AdminLayout title={item?.subject || 'Nueva newsletter'} current="newsletter">
  <a href="/admin/newsletter/" class="text-sm">‹ Newsletter</a>
  {c.sample && <p class="adm-card mt-4 border-l-4 border-l-orange px-4 py-3 text-sm">Datos de ejemplo: guardar y enviar se activarán al conectar la base de datos.</p>}
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="adm-h1">{isNew ? 'Nueva newsletter' : item!.subject || '(sin asunto)'}</h1>
    {item && <span class={`adm-pill ${item.status === 'sent' ? 'adm-pill-ok' : 'adm-pill-warn'}`}>{newsletterLabel[item.status]}</span>}
  </div>
  {q.has('saved') && <p role="status" class="mt-4 rounded-lg bg-[#e1f3ea] px-4 py-3 text-sm text-[#1b6b45]">Borrador guardado.</p>}
  {q.has('enviada') && <p role="status" class="mt-4 rounded-lg bg-[#e1f3ea] px-4 py-3 text-sm text-[#1b6b45]">Enviada a {q.get('enviada')} personas{Number(q.get('fallidos')) > 0 ? `, y ${q.get('fallidos')} envíos han fallado.` : '.'}</p>}
  {error && <p role="alert" class="mt-4 rounded-lg bg-[#fdecec] px-4 py-3 text-sm text-[#8f2a2a]">{error}</p>}

  {locked ? (
    <div class="mt-8 grid items-start gap-6 lg:grid-cols-[1fr_340px]">
      <iframe title="Contenido enviado" class="h-[640px] w-full rounded-lg border border-line bg-white" sandbox="" srcdoc={item!.body_html}></iframe>
      <div class="adm-card p-5 text-sm">
        <p class="font-medium">{item!.subject}</p>
        <p class="adm-hint">Enviada el {item!.sent_at ? new Date(item!.sent_at).toLocaleString('es') : '—'}</p>
        <p class="mt-3">{item!.recipients} envíos correctos{item!.failed ? ` · ${item!.failed} fallidos` : ''}</p>
        <p class="adm-hint">Una newsletter enviada no se puede editar.</p>
      </div>
    </div>
  ) : (
    <form id="nl" method="post" action="/admin/api/newsletter/save" class="mt-8 grid items-start gap-6 lg:grid-cols-[1fr_340px]">
      <input type="hidden" name="id" value={id} />
      <div id="draft-banner" hidden class="adm-card flex flex-wrap items-center gap-3 border-l-4 border-l-orange px-4 py-3 text-sm lg:col-span-2" role="status">
        <span id="draft-text" class="flex-1"></span>
        <button type="button" class="adm-btn !min-h-[38px] adm-btn-primary" id="draft-restore">Recuperar</button>
        <button type="button" class="adm-btn !min-h-[38px]" id="draft-discard">Descartar</button>
      </div>
      <div class="adm-card flex min-w-0 flex-col gap-6 p-6">
        <div>
          <div class="flex items-baseline justify-between gap-3"><label class="adm-label" for="subject">Asunto</label><span class="adm-hint !mt-0" id="subject-count" aria-live="polite"></span></div>
          <input id="subject" name="subject" class="adm-input" value={item?.subject ?? ''} maxlength="200" placeholder="Lo primero que verá quien la reciba" />
          <p class="adm-hint">Mejor si se lee entero en el móvil: unos 60 caracteres.</p>
        </div>
        <div>
          <div class="flex items-baseline justify-between gap-3"><label class="adm-label" for="preheader">Texto de avance <span class="font-normal text-ink-muted">(opcional)</span></label><span class="adm-hint !mt-0" id="preheader-count" aria-live="polite"></span></div>
          <input id="preheader" name="preheader" class="adm-input" value={item?.preheader ?? ''} maxlength="200" placeholder="Aparece junto al asunto en la bandeja de entrada" />
        </div>
        <div>
          <p class="adm-label" id="ed-label">Texto</p>
          <RichEditor name="body_html" value={item?.body_html ?? ''} labelId="ed-label" />
        </div>
      </div>

      <aside class="flex flex-col gap-4">
        <div class="adm-card flex flex-col gap-3 p-5">
          <button class="adm-btn adm-btn-primary w-full" type="submit">Guardar borrador</button>
          <button class="adm-btn w-full" type="button" id="btn-preview">Vista previa</button>
          <button class="adm-btn w-full" type="button" id="btn-test">Enviarme una prueba</button>
          <p id="test-msg" role="status" class="text-sm" hidden></p>
        </div>
        {!isNew && (
          <div class="adm-card p-5">
            <p class="font-medium">Enviar a la lista</p>
            <p class="adm-hint">Llegará a <strong>{confirmed}</strong> suscriptores confirmados. No se puede deshacer.</p>
            <p id="dirty-msg" hidden class="mt-3 rounded-md bg-[#fdf0d8] px-3 py-2 text-sm text-[#8a5a00]">Hay cambios sin guardar. Guarda el borrador antes de enviar.</p>
            <div id="send-box" class="mt-3 flex flex-col gap-3">
              <label class="flex items-start gap-2.5 text-sm"><input type="checkbox" id="confirm-send" class="mt-0.5 h-[18px] w-[18px]" /> He revisado el texto y me he enviado una prueba.</label>
              <button class="adm-btn adm-btn-primary w-full" type="submit" id="btn-send" formaction="/admin/api/newsletter/send" disabled>Enviar a {confirmed} personas</button>
              <input type="hidden" name="expected" value={confirmed} />
              <input type="hidden" name="confirm" id="confirm-field" value="" />
            </div>
          </div>
        )}
        {isNew && <p class="adm-hint">Guarda el borrador para poder enviarlo.</p>}
      </aside>
    </form>
  )}

  <dialog id="preview-dlg" class="ed-dialog" aria-label="Vista previa">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line p-3">
      <p class="font-medium">Así lo verán</p>
      <div class="flex gap-1" role="group" aria-label="Tamaño de pantalla">
        <button type="button" class="adm-btn !min-h-[36px] !bg-navy !text-white" data-device="desktop">Ordenador</button>
        <button type="button" class="adm-btn !min-h-[36px]" data-device="mobile">Móvil</button>
      </div>
      <form method="dialog"><button class="adm-btn !min-h-[36px]">Cerrar</button></form>
    </div>
    <div class="flex-1 overflow-auto bg-[#e6ecf2] p-4"><iframe id="preview-frame" title="Vista previa del correo" sandbox="" class="mx-auto block h-full min-h-[520px] w-full max-w-[680px] bg-white transition-[max-width]"></iframe></div>
  </dialog>

  <style is:global>
    .ed-dialog { margin: auto; width: min(760px, 94vw); height: min(820px, 92vh); padding: 0; border: 0; border-radius: 12px; }
    .ed-dialog[open] { display: flex; flex-direction: column; }
    .ed-dialog::backdrop { background: rgba(14,34,56,.6); }
  </style>

  <script define:vars={{ id, serverHtml: item?.body_html ?? '', serverSubject: item?.subject ?? '', serverPre: item?.preheader ?? '', justSaved: q.has('saved') || q.has('enviada') }}>
    // Module scripts (the editor) run before DOMContentLoaded, so the editor API exists by then.
    document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('nl');
    if (form) {
      const $ = (i) => document.getElementById(i);
      const rte = document.querySelector('[data-rte]').rte;
      const field = form.querySelector('[name=body_html]');
      const subject = $('subject'), pre = $('preheader');
      const key = `uv4peace-nl-${id}`;
      const store = { get: () => { try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch { return null; } }, set: (v) => { try { localStorage.setItem(key, JSON.stringify(v)); } catch {} }, del: () => { try { localStorage.removeItem(key); } catch {} } };
      let changed = false, submitting = false, timer;

      const counter = (input, out, max) => { const n = input.value.length; out.textContent = `${n} / ${max}`; out.style.color = n > max ? '#8a5a00' : ''; };
      const counters = () => { counter(subject, $('subject-count'), 60); counter(pre, $('preheader-count'), 100); };

      const sendBtn = $('btn-send'), confirmBox = $('confirm-send'), confirmField = $('confirm-field'), dirty = $('dirty-msg');
      const gate = () => { if (sendBtn) sendBtn.disabled = changed || !confirmBox?.checked; if (confirmField) confirmField.value = confirmBox?.checked ? 'yes' : ''; if (dirty) dirty.hidden = !changed; };
      confirmBox?.addEventListener('change', gate);

      const touched = () => {
        changed = true; gate(); counters();
        clearTimeout(timer);
        timer = setTimeout(() => { store.set({ subject: subject.value, preheader: pre.value, html: field.value, at: Date.now() }); rte.setNote('Copia guardada en este navegador'); }, 1200);
      };
      document.addEventListener('editor:change', touched);
      [subject, pre].forEach((i) => i.addEventListener('input', touched));
      form.addEventListener('submit', () => { submitting = true; });
      window.addEventListener('beforeunload', (e) => { if (changed && !submitting) { e.preventDefault(); e.returnValue = ''; } });

      // Recover work that was typed but never saved (closed tab, lost connection).
      if (justSaved) store.del();
      const local = store.get();
      if (local && !justSaved && (local.html !== serverHtml || local.subject !== serverSubject || local.preheader !== serverPre)) {
        $('draft-text').textContent = `Hay una versión sin guardar del ${new Date(local.at).toLocaleString('es', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}.`;
        $('draft-banner').hidden = false;
        $('draft-restore').addEventListener('click', () => { subject.value = local.subject; pre.value = local.preheader; rte.setHtml(local.html); $('draft-banner').hidden = true; touched(); });
        $('draft-discard').addEventListener('click', () => { store.del(); $('draft-banner').hidden = true; });
      }
      counters(); gate();

      const data = () => { const f = new FormData(); f.set('subject', subject.value); f.set('preheader', pre.value); f.set('body_html', field.value); return f; };

      const dlg = $('preview-dlg'), frame = $('preview-frame');
      $('btn-preview')?.addEventListener('click', async () => {
        frame.srcdoc = await (await fetch('/admin/api/newsletter/preview', { method: 'POST', body: data() })).text();
        dlg.showModal();
      });
      dlg.querySelectorAll('[data-device]').forEach((b) => b.addEventListener('click', () => {
        frame.style.maxWidth = b.dataset.device === 'mobile' ? '375px' : '680px';
        dlg.querySelectorAll('[data-device]').forEach((x) => { x.classList.toggle('!bg-navy', x === b); x.classList.toggle('!text-white', x === b); });
      }));

      const testBtn = $('btn-test'), msg = $('test-msg');
      testBtn?.addEventListener('click', async () => {
        testBtn.disabled = true; msg.hidden = true;
        try {
          const j = await (await fetch('/admin/api/newsletter/test', { method: 'POST', body: data() })).json();
          msg.textContent = j.ok ? `Prueba enviada a ${j.to}. Revisa también la carpeta de spam.` : (j.error ?? 'No se ha podido enviar la prueba.');
          msg.className = `text-sm ${j.ok ? 'text-[#1b6b45]' : 'text-[#8f2a2a]'}`;
        } catch { msg.textContent = 'No se ha podido enviar la prueba.'; msg.className = 'text-sm text-[#8f2a2a]'; }
        msg.hidden = false; testBtn.disabled = false;
      });
    }
    });
  </script>
</AdminLayout>
