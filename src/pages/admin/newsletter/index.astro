---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { connect, listNewsletters, listSubscribers, countByStatus, newsletterLabel } from '../../../lib/newsletter-db';

const c = connect(Astro.request, Astro.cookies);
const [news, subs] = await Promise.all([listNewsletters(c), listSubscribers(c)]);
const n = countByStatus(subs);
const date = (d: string | null) => (d ? new Date(d).toLocaleDateString('es', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
---
<AdminLayout title="Newsletter" current="newsletter">
  {c.sample && <p class="adm-card mb-6 border-l-4 border-l-orange px-4 py-3 text-sm">Datos de ejemplo: el panel aún no está conectado a la base de datos.</p>}
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow text-ink-muted">Newsletter</p>
      <h1 class="adm-h1 mt-2">Suscriptores y envíos</h1>
    </div>
    <a href="/admin/newsletter/nueva/" class="adm-btn adm-btn-primary">+ Nueva newsletter</a>
  </div>

  <a href="/admin/newsletter/suscriptores/" class="adm-card card-lift mt-8 grid gap-4 p-5 hover:no-underline sm:grid-cols-3" aria-label="Ver suscriptores">
    <div><p class="text-3xl font-light tabular-nums text-sky-text">{n.confirmed}</p><p class="adm-hint !mt-0.5">Confirmados: reciben las newsletters</p></div>
    <div><p class="text-3xl font-light tabular-nums">{n.pending}</p><p class="adm-hint !mt-0.5">Sin confirmar: no han pulsado el enlace</p></div>
    <div><p class="text-3xl font-light tabular-nums">{n.unsubscribed}</p><p class="adm-hint !mt-0.5">De baja</p></div>
  </a>
  <p class="mt-3 text-sm"><a href="/admin/newsletter/suscriptores/">Ver y gestionar suscriptores ›</a></p>

  <h2 class="mt-10 text-sm font-medium uppercase tracking-[0.14em] text-ink-muted">Newsletters</h2>
  {news.length === 0 ? (
    <div class="adm-card mt-4 p-8 text-center"><p class="font-medium">Todavía no hay ninguna newsletter</p><p class="adm-hint">Escribe la primera y envíate una prueba antes de mandarla.</p></div>
  ) : (
    <div class="adm-card mt-4">
      {news.map((x) => (
        <a href={`/admin/newsletter/${x.id}/`} class="adm-row hover:no-underline">
          <span class="min-w-0 flex-1">
            <span class="block truncate font-medium">{x.subject || '(sin asunto)'}</span>
            <span class="block truncate text-sm text-ink-muted">{x.status === 'sent' ? `Enviada el ${date(x.sent_at)} a ${x.recipients} personas` : `Creada el ${date(x.created_at)}`}</span>
          </span>
          <span class={`adm-pill ${x.status === 'sent' ? 'adm-pill-ok' : x.status === 'draft' ? 'adm-pill-warn' : ''}`}>{newsletterLabel[x.status]}</span>
          <span aria-hidden="true" class="text-ink-muted">›</span>
        </a>
      ))}
    </div>
  )}
</AdminLayout>
