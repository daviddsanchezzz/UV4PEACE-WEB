---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSettings } from '../../lib/content';
import PhotoField from '../../components/admin/PhotoField.astro';
import { createClient, supabaseConfigured } from '../../lib/supabase';

const s = await getSettings(supabaseConfigured() ? createClient(Astro.request, Astro.cookies) : undefined);
const errors: Record<string, string> = { correo: 'El correo no parece válido.', paypal: 'El enlace de PayPal debe empezar por https://', ga: 'El ID de Google Analytics debe tener el formato G-XXXXXXXXXX.', redes: 'Los enlaces de redes deben empezar por https://', fundadora: 'La fundadora necesita nombre y cargo.', foto: 'La foto de la fundadora no es válida. Súbela de nuevo.', guardar: 'No se pudo guardar. Inténtalo de nuevo en un momento.' };
const error = errors[Astro.url.searchParams.get('error') ?? ''];
const saved = Astro.url.searchParams.has('ok');
const social = ['Instagram', 'LinkedIn', 'YouTube'].map((label) => ({ label, href: s.social.find((x) => x.label === label)?.href ?? '' }));
---
<AdminLayout title="Ajustes" current="ajustes">
  <p class="eyebrow text-ink-muted">Ajustes</p>
  <h1 class="adm-h1 mt-2">Correo, donaciones, visitas y redes</h1>
  <p class="mt-3 max-w-[62ch] text-ink-muted">Estos datos aparecen en toda la web. Al guardar, se actualizan en la web en menos de un minuto.</p>

  {error && <p role="alert" class="adm-card mt-6 border-l-4 border-l-[#a33] p-4 text-[#a33]">{error}</p>}
  {saved && <p role="status" class="adm-pill adm-pill-ok mt-6 !text-sm">Ajustes guardados. Se verán en la web en menos de un minuto.</p>}
  <form class="mt-8 grid items-start gap-6 xl:grid-cols-2" method="post" action="/admin/api/settings">
    <div class="flex flex-col gap-6">
      <section class="adm-card flex flex-col gap-6 p-6">
      <h2 class="text-xl font-medium">Correo de contacto</h2>
      <div>
        <label class="adm-label" for="email">Correo</label>
        <input id="email" name="email" type="email" required class="adm-input" value={s.email} />
        <p class="adm-hint">Se muestra en el pie de página y en la página de contacto. <strong>Los mensajes del formulario de contacto llegan a este correo.</strong> Al darle a «Responder», se contesta directamente a quien escribió.</p>
      </div>
      </section>

      <section class="adm-card flex flex-col gap-6 p-6">
      <h2 class="text-xl font-medium">Donaciones</h2>
      <div>
        <label class="adm-label" for="paypal">Enlace de PayPal</label>
        <input id="paypal" name="paypal" type="url" class="adm-input" value={s.paypalUrl} placeholder="https://www.paypal.com/donate/?hosted_button_id=…" />
        <p class="adm-hint">Debe empezar por https://. Mientras esté vacío, el botón «Donate via PayPal» abre un correo en lugar de PayPal.</p>
      </div>
      </section>

      <section class="adm-card flex flex-col gap-6 p-6">
        <h2 class="text-xl font-medium">Estadísticas de visitas</h2>
        <div>
          <label class="adm-label" for="ga">ID de Google Analytics</label>
          <input id="ga" name="ga" class="adm-input" value={s.analyticsId} placeholder="G-XXXXXXXXXX" pattern="G-[A-Za-z0-9]{4,14}" autocapitalize="characters" spellcheck="false" />
          <p class="adm-hint">Lo encuentras en Google Analytics, en Administrar, Flujos de datos. Empieza por «G-». <strong>Mientras esté vacío, la web no mide visitas y no muestra el aviso de cookies.</strong> Al rellenarlo, los visitantes verán el aviso y solo se mide a quien lo acepte.</p>
        </div>
      </section>
    </div>

    <section class="adm-card flex flex-col gap-6 p-6">
      <h2 class="text-xl font-medium">Redes sociales</h2>
      {social.map((x) => (
        <div>
          <label class="adm-label" for={x.label}>{x.label}</label>
          <input id={x.label} name={`social_${x.label}`} type="url" class="adm-input" value={x.href} placeholder="https://" />
        </div>
      ))}
      <p class="adm-hint !mt-0">Solo se muestran las redes que tengan enlace. Déjalo vacío para ocultar una.</p>
    </section>


    <div class="flex flex-col gap-6 xl:col-span-2">
      <section class="adm-card flex flex-col gap-6 p-6">
        <h2 class="text-xl font-medium">«Featured in» (home)</h2>
        <div>
          <label class="adm-label" for="featured_in">Medios</label>
          <textarea id="featured_in" name="featured_in" class="adm-input !min-h-[110px]" placeholder={'Variety\nForbes'}>{s.featuredIn.join('\n')}</textarea>
          <p class="adm-hint">Un nombre por línea. Salen en la franja «Featured in» de la home y de Press. Para el resto de medios, usa la sección Medios.</p>
        </div>
      </section>

      <section class="adm-card grid gap-6 p-6 lg:grid-cols-[1fr_300px]">
        <div class="flex flex-col gap-6">
          <h2 class="text-xl font-medium">Fundadora</h2>
          <p class="adm-hint !mt-0">Sale en la home («Our founder») y en la página People.</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div><label class="adm-label" for="f_name">Nombre</label><input id="f_name" name="f_name" required class="adm-input" value={s.founder.name} /></div>
            <div><label class="adm-label" for="f_role">Cargo</label><input id="f_role" name="f_role" required class="adm-input" value={s.founder.role} /></div>
          </div>
          <div>
            <label class="adm-label" for="f_quote">Cita</label>
            <textarea id="f_quote" name="f_quote" class="adm-input">{s.founder.quote}</textarea>
          </div>
          <div>
            <label class="adm-label" for="f_bio">Biografía</label>
            <textarea id="f_bio" name="f_bio" class="adm-input">{s.founder.bio}</textarea>
            <p class="adm-hint">Opcional. Sale en la página People bajo la cita.</p>
          </div>
        </div>
        <PhotoField name="f_photo" label="Foto" value={s.founder.photo} ratio="3 / 4" />
      </section>
    </div>

    <div class="adm-actions xl:col-span-2">
      <button class="adm-btn adm-btn-primary" type="submit">Guardar cambios</button>
      <a class="adm-btn" href="/admin/inicio/">Cancelar</a>
    </div>
  </form>

  <section class="adm-card mt-8 flex flex-col gap-4 p-6" id="mover">
    <h2 class="text-xl font-medium">Mover fotos al almacén</h2>
    <p class="adm-hint !mt-0">Pasa al almacén de fotos de la web (Supabase) las que todavía están guardadas dentro del código de la web o cargan desde la web antigua, como las de la junta, y actualiza las direcciones. Es seguro repetirlo: si no queda nada por mover, no hace nada.</p>
    <div class="flex flex-wrap items-center gap-3"><button type="button" id="mover-btn" class="adm-btn">Mover fotos ahora</button></div>
    <ul id="mover-log" class="adm-hint !mt-0 flex flex-col gap-1" role="status" aria-live="polite"></ul>
  </section>

  <script>
    const btn = document.getElementById('mover-btn') as HTMLButtonElement;
    const log = document.getElementById('mover-log')!;
    const say = (t: string) => { const li = document.createElement('li'); li.textContent = t; log.appendChild(li); };
    const call = async (payload: object) => {
      const res = await fetch('/admin/api/migrar-fotos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const out = await res.json().catch(() => ({ ok: false, error: 'Respuesta no válida.' }));
      if (!out.ok) throw new Error(out.error || 'Error');
      return out;
    };
    btn.addEventListener('click', async () => {
      btn.disabled = true; log.replaceChildren();
      try {
        const { files } = await call({ action: 'plan' });
        if (!files.length) { say('No queda ninguna foto por mover.'); return; }
        say(`${files.length} fotos por mover.`);
        const map: Record<string, unknown> = {};
        let n = 0;
        for (const src of files as string[]) {
          const r = await call({ action: 'upload', src });
          map[src] = { url: r.url, w: r.w, h: r.h };
          say(`${++n} de ${files.length}: ${src.split('/').pop()}`);
        }
        const done = await call({ action: 'apply', map });
        say(`Listo. ${done.changed} registros actualizados.`);
      } catch (e) {
        say(`Se ha parado: ${e instanceof Error ? e.message : 'error'}. Puedes volver a pulsar el botón; continuará donde se quedó.`);
      } finally { btn.disabled = false; }
    });
  </script>
</AdminLayout>
