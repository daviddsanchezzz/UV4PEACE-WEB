---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { projects, type Project } from '../../../data/projects';
import { people } from '../../../data/people';

const { slug } = Astro.params;
const isNew = slug === 'nuevo';
const found = projects.find((p) => p.slug === slug);
if (!isNew && !found) return Astro.redirect('/admin/proyectos/');
const p: Project = found ?? { slug: '', title: '', status: 'ongoing', yearStart: '', dateLabel: '', city: '', summary: '', cover: null, editions: [] };
const editions = p.editions ?? [];
const tab = Astro.url.searchParams.get('tab') === 'ediciones' ? 'ediciones' : 'datos';
const selected = editions.find((e) => e.year === Astro.url.searchParams.get('ed')) ?? editions.find((e) => !e.upcoming && e.year === '2026') ?? editions[editions.length - 1];
const tabs = [{ id: 'datos', l: 'Datos del proyecto' }, { id: 'ediciones', l: `Ediciones${editions.length ? ` (${editions.length})` : ''}` }, { id: 'fotos', l: 'Fotos' }];
---
<AdminLayout title={isNew ? 'Nuevo proyecto' : p.title} current="proyectos">
  <a href="/admin/proyectos/" class="text-sm">‹ Todos los proyectos</a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="adm-h1">{isNew ? 'Añadir proyecto' : p.title}</h1>
    <div class="flex gap-3">
      {!isNew && <a href={`/projects/${p.slug}/`} class="adm-btn" target="_blank" rel="noopener">Ver en la web</a>}
    </div>
  </div>

  <div class="mt-8 flex gap-1 overflow-x-auto border-b border-line" role="tablist" aria-label="Secciones del proyecto">
    {tabs.map((t) => (
      <button type="button" role="tab" data-tab={t.id} aria-selected={tab === t.id} class="adm-tab">{t.l}</button>
    ))}
  </div>

  <section data-panel="datos" hidden={tab !== 'datos'} class="mt-8">
    <div class="adm-card grid gap-6 p-6 lg:grid-cols-2">
      <div class="lg:col-span-2">
        <label class="adm-label" for="title">Título</label>
        <input id="title" class="adm-input" value={p.title} />
      </div>
      <div>
        <label class="adm-label" for="status">Estado</label>
        <select id="status" class="adm-input">
          <option value="ongoing" selected={p.status === 'ongoing'}>En marcha</option>
          <option value="past" selected={p.status === 'past'}>Pasado</option>
        </select>
      </div>
      <div>
        <label class="adm-label" for="dates">Fechas (como se leen en la web)</label>
        <input id="dates" class="adm-input" value={p.dateLabel} />
      </div>
      <div>
        <label class="adm-label" for="city">Ciudad o lugar</label>
        <input id="city" class="adm-input" value={p.city} />
      </div>
      <div>
        <label class="adm-label" for="feat">¿Destacar en la home?</label>
        <select id="feat" class="adm-input"><option selected={!p.featured}>No</option><option selected={p.featured}>Sí, es el proyecto destacado</option></select>
      </div>
      <div class="lg:col-span-2">
        <label class="adm-label" for="summary">Resumen</label>
        <textarea id="summary" class="adm-input !min-h-[96px]">{p.summary}</textarea>
        <p class="adm-hint">Una o dos frases. Aparece en la tarjeta del proyecto.</p>
      </div>
      {p.intro && (
        <div class="lg:col-span-2">
          <label class="adm-label" for="intro">Texto de introducción</label>
          <textarea id="intro" class="adm-input">{p.intro}</textarea>
        </div>
      )}
    </div>
  </section>

  <section data-panel="ediciones" hidden={tab !== 'ediciones'} class="mt-8">
    {editions.length === 0 ? (
      <div class="adm-card p-8 text-center">
        <p class="font-medium">Este proyecto no tiene ediciones</p>
        <p class="adm-hint">Las ediciones sirven para proyectos que se repiten cada año, con su sede, director y line-up.</p>
        <button class="adm-btn adm-btn-primary mt-4" type="button">+ Añadir primera edición</button>
      </div>
    ) : (
      <div class="grid items-start gap-6 lg:grid-cols-[240px_1fr]">
        <div class="adm-card flex gap-1 overflow-x-auto p-2 lg:block">
          {editions.map((e) => (
            <button type="button" data-ed={e.year} aria-pressed={e.year === selected?.year} class="adm-ed">
              <span class="font-medium">{e.year}</span>
              <span class="text-sm opacity-80">{e.upcoming ? 'Próxima' : e.event || `Edición ${e.number}`}</span>
            </button>
          ))}
          <button type="button" class="adm-btn flex-none !border-dashed lg:mt-2 lg:w-full">+ Nueva edición</button>
        </div>

        <div>
          {editions.map((e) => (
            <div data-edform={e.year} hidden={e.year !== selected?.year} class="adm-card flex flex-col gap-6 p-6">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-xl font-medium">Edición {e.year}</h2>
                <label class="flex items-center gap-2 text-sm"><input type="checkbox" checked={e.upcoming} /> Aún no ha ocurrido (se muestra «Próximamente»)</label>
              </div>
              <div class="grid gap-6 sm:grid-cols-2">
                <div><label class="adm-label">Fecha</label><input class="adm-input" value={e.date} /></div>
                <div><label class="adm-label">Evento</label><input class="adm-input" value={e.event} placeholder="Ej. CSW70" /></div>
                <div>
                  <label class="adm-label">Sede</label>
                  <input class="adm-input" value={e.venue} placeholder="Sede sin confirmar" />
                  {!e.venue && !e.upcoming && <p class="adm-hint text-[#8a5a00]">Si la dejas vacía, la web no muestra la sede.</p>}
                </div>
                <div><label class="adm-label">Dirección musical</label><input class="adm-input" value={e.conductor} /></div>
              </div>
              <div>
                <label class="adm-label">Descripción</label>
                <textarea class="adm-input !min-h-[100px]">{e.description}</textarea>
              </div>
              <div>
                <label class="adm-label">Enlace al vídeo</label>
                <input class="adm-input" value={e.watchUrl} placeholder="https://youtube.com/…" />
              </div>
              <div>
                <div class="flex items-baseline justify-between"><p class="adm-label !mb-0">Line-up ({e.lineup.length})</p><span class="adm-hint !mt-0">Elige de Personas o escribe un nombre nuevo</span></div>
                <div class="mt-3 flex flex-col gap-2" data-lineup>
                  {e.lineup.length === 0 && <p class="adm-hint" data-empty>Nadie añadido todavía.</p>}
                  {e.lineup.map((m) => (
                    <div class="grid grid-cols-[1fr_auto] gap-2 sm:flex sm:items-center" data-member>
                      <input class="adm-input" list="people-list" value={m.name} aria-label="Nombre" />
                      <input class="adm-input col-span-2 row-start-2 sm:max-w-[200px]" value={m.role} aria-label="Función" />
                      <button type="button" class="adm-btn col-start-2 row-start-1 !min-h-[46px] !px-3" data-remove aria-label={`Quitar a ${m.name}`}>✕</button>
                    </div>
                  ))}
                </div>
                <button type="button" class="adm-btn mt-3" data-add>+ Añadir a la persona</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
    <datalist id="people-list">{people.map((x) => <option value={x.name}></option>)}</datalist>
  </section>

  <section data-panel="fotos" hidden class="mt-8 flex flex-col gap-6">
    <div class="adm-card p-6">
      <h2 class="text-xl font-medium">Portada y cabecera</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-2">
        {[{ k: 'Portada (tarjeta del proyecto)', r: p.cover }, { k: 'Cabecera (página del proyecto)', r: p.hero ?? null }].map((x) => (
          <div>
            <p class="adm-label">{x.k}</p>
            <div class="grid aspect-[16/10] place-items-center rounded-lg bg-placeholder px-4 text-center text-sm text-placeholder-line">{x.r ? x.r.alt : 'Sin foto'}</div>
            <button class="adm-btn mt-3 w-full sm:w-auto" type="button">{x.r ? 'Cambiar foto' : 'Subir foto'}</button>
          </div>
        ))}
      </div>
    </div>
    <div class="adm-card p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-medium">Galería ({(p.gallery ?? []).length})</h2>
        <button class="adm-btn" type="button">+ Añadir fotos</button>
      </div>
      {(p.gallery ?? []).length === 0 ? <p class="adm-hint mt-3">Este proyecto no tiene galería.</p> : (
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {(p.gallery ?? []).map((g) => (
            <div class="rounded-lg border border-line p-2">
              <div class="grid aspect-[4/3] place-items-center rounded bg-placeholder px-2 text-center text-xs text-placeholder-line">{g.alt}</div>
              <div class="mt-2 flex items-center justify-between text-sm"><span class="adm-pill">{g.span === 'wide' ? 'Ancha' : g.span === 'tall' ? 'Alta' : g.span === 'big' ? 'Grande' : 'Normal'}</span><button type="button" aria-label="Quitar foto">✕</button></div>
            </div>
          ))}
        </div>
      )}
    </div>
    {p.documentary && (
      <div class="adm-card flex flex-col gap-6 p-6">
        <h2 class="text-xl font-medium">Documental</h2>
        <div><label class="adm-label" for="doc-title">Título</label><input id="doc-title" class="adm-input" value={p.documentary.title} /></div>
        <div><label class="adm-label" for="doc-text">Texto</label><textarea id="doc-text" class="adm-input">{p.documentary.text}</textarea></div>
        <div><label class="adm-label" for="doc-trailer">Enlace al tráiler</label><input id="doc-trailer" class="adm-input" value={p.documentary.trailerUrl} /></div>
        <div>
          <p class="adm-label">Festivales ({p.documentary.festivals.length})</p>
          <div class="flex flex-col gap-2">
            {p.documentary.festivals.map((f) => (
              <div class="grid grid-cols-[1fr_auto] gap-2 sm:flex sm:items-center">
                <input class="adm-input sm:max-w-[140px]" value={f.date} aria-label="Fecha" />
                <button type="button" class="adm-btn col-start-2 row-start-1 !min-h-[46px] !px-3 sm:order-last" aria-label="Quitar">✕</button>
                <input class="adm-input col-span-2 row-start-2 sm:col-auto sm:flex-1" value={f.name} aria-label="Festival" />
                <input class="adm-input col-span-2 row-start-3 sm:col-auto sm:max-w-[200px]" value={f.result} aria-label="Resultado" />
              </div>
            ))}
          </div>
          <button class="adm-btn mt-3" type="button">+ Añadir festival</button>
        </div>
      </div>
    )}
  </section>

  <div class="adm-actions">
    <button class="adm-btn adm-btn-primary" type="button">Guardar cambios</button>
    <a class="adm-btn" href="/admin/proyectos/">Cancelar</a>
  </div>

  <style is:global>
    .adm-tab { flex: none; padding: 12px 18px; border: 0; border-bottom: 3px solid transparent; background: none; font: inherit; font-size: 16px; color: var(--color-ink-muted); cursor: pointer; margin-bottom: -1px; }
    .adm-tab[aria-selected="true"] { color: var(--color-navy); font-weight: 500; border-bottom-color: var(--color-orange); }
    .adm-ed { display: flex; flex: none; min-width: 104px; flex-direction: column; gap: 2px; padding: 10px 14px; border: 0; border-radius: 8px; background: none; font: inherit; text-align: left; color: var(--color-ink); cursor: pointer; }
    @media (min-width: 1024px) { .adm-ed { width: 100%; } }
    .adm-ed:hover { background: var(--color-surface-soft); }
    .adm-ed[aria-pressed="true"] { background: var(--color-navy); color: #fff; }
    [hidden] { display: none !important; }
  </style>
  <script>
    const tabs = document.querySelectorAll<HTMLElement>('[data-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    const show = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));
    const eds = document.querySelectorAll<HTMLElement>('[data-ed]');
    const forms = document.querySelectorAll<HTMLElement>('[data-edform]');
    eds.forEach((b) => b.addEventListener('click', () => {
      eds.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      forms.forEach((f) => (f.hidden = f.dataset.edform !== b.dataset.ed));
    }));
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('[data-remove]')) t.closest('[data-member]')?.remove();
      if (t.matches('[data-add]')) {
        const list = t.parentElement!.querySelector('[data-lineup]')!;
        list.querySelector('[data-empty]')?.remove();
        const row = document.createElement('div');
        row.className = 'grid grid-cols-[1fr_auto] gap-2 sm:flex sm:items-center';
        row.setAttribute('data-member', '');
        row.innerHTML = '<input class="adm-input" list="people-list" placeholder="Nombre" aria-label="Nombre" /><input class="adm-input col-span-2 row-start-2 sm:max-w-[200px]" placeholder="Función" aria-label="Función" /><button type="button" class="adm-btn col-start-2 row-start-1 !min-h-[46px] !px-3" data-remove aria-label="Quitar">✕</button>';
        list.appendChild(row);
        row.querySelector('input')?.focus();
      }
    });
  </script>
</AdminLayout>
