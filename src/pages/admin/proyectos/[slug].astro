---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PhotoField from '../../../components/admin/PhotoField.astro';
import EditionForm from '../../../components/admin/EditionForm.astro';
import { getPeople, getProjects, type Project } from '../../../lib/content';
import { createClient, supabaseConfigured } from '../../../lib/supabase';

const db = supabaseConfigured() ? createClient(Astro.request, Astro.cookies) : undefined;
const [people, projects] = await Promise.all([getPeople(db), getProjects(db)]);
const { slug } = Astro.params;
const isNew = slug === 'nuevo';
const found = projects.find((p) => p.slug === slug);
if (!isNew && !found) return Astro.redirect('/admin/proyectos/');
const p: Project = found ?? { slug: '', title: '', status: 'ongoing', yearStart: '', dateLabel: '', city: '', summary: '', cover: null, editions: [], published: true };
const editions = p.editions ?? [];
const tab = ['ediciones', 'fotos'].includes(Astro.url.searchParams.get('tab') ?? '') ? Astro.url.searchParams.get('tab')! : 'datos';
const selected = editions.find((e) => e.year === Astro.url.searchParams.get('ed')) ?? editions.filter((e) => !e.upcoming).at(-1) ?? editions.at(-1);
const tabs = [{ id: 'datos', l: 'Datos del proyecto' }, { id: 'ediciones', l: 'Ediciones' }, { id: 'fotos', l: 'Fotos y documental' }];
const gallery = p.gallery ?? [];
const doc = p.documentary;
const pb = p.partner;
const errors: Record<string, string> = {
  faltan: 'Faltan el título o el estado.', mes: 'El mes de inicio debe tener el formato AAAA-MM, por ejemplo 2027-03.', anio: 'Cada edición necesita un año de 4 cifras, sin repetir.',
  enlace: 'Los enlaces deben empezar por https://', video: 'Los vídeos deben ser enlaces de YouTube o Vimeo.', foto: 'Alguna foto no es válida. Súbela de nuevo.', guardar: 'No se pudo guardar. Inténtalo de nuevo en un momento.',
  funcion: 'La base de datos aún no tiene activada la función de guardado de proyectos. Avisa a quien mantiene la web.', quitar: 'No se pudo quitar. Inténtalo de nuevo en un momento.',
};
const error = errors[Astro.url.searchParams.get('error') ?? ''];
---
<AdminLayout title={isNew ? 'Nuevo proyecto' : p.title} current="proyectos">
  <a href="/admin/proyectos/" class="text-sm">‹ Todos los proyectos</a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="adm-h1">{isNew ? 'Añadir proyecto' : p.title}</h1>
    <div class="flex gap-3">
      {!isNew && <a href={`/projects/${p.slug}/`} class="adm-btn" target="_blank" rel="noopener">Ver en la web</a>}
    </div>
  </div>
  {error && <p role="alert" class="adm-card mt-6 border-l-4 border-l-[#a33] p-4 text-[#a33]">{error}</p>}

  <form id="project-form" novalidate method="post" action="/admin/api/projects/save">
  <input type="hidden" name="slug" value={isNew ? '' : p.slug} />
  <input type="hidden" name="payload" id="payload" />

  <div class="mt-8 flex gap-1 overflow-x-auto border-b border-line" role="tablist" aria-label="Secciones del proyecto">
    {tabs.map((t) => (
      <button type="button" role="tab" data-tab={t.id} aria-selected={tab === t.id} class="adm-tab">{t.l}</button>
    ))}
  </div>

  <section data-panel="datos" hidden={tab !== 'datos'} class="mt-8">
    <div class="adm-card grid gap-6 p-6 lg:grid-cols-2">
      <div class="lg:col-span-2">
        <label class="adm-label" for="title">Título</label>
        <input id="title" data-f="title" class="adm-input" value={p.title} />
      </div>
      <div>
        <label class="adm-label" for="title_accent">Parte del título en color</label>
        <input id="title_accent" data-f="title_accent" class="adm-input" value={p.titleAccent ?? ''} placeholder="Ej. in Music" />
        <p class="adm-hint">Opcional. Debe ser un trozo del título tal como está escrito.</p>
      </div>
      <div>
        <label class="adm-label" for="status">Estado</label>
        <select id="status" data-f="status" class="adm-input">
          <option value="ongoing" selected={p.status === 'ongoing'}>En marcha</option>
          <option value="past" selected={p.status === 'past'}>Pasado</option>
        </select>
      </div>
      <div>
        <label class="adm-label" for="dates">Fechas (como se leen en la web)</label>
        <input id="dates" data-f="date_label" class="adm-input" value={p.dateLabel} placeholder="2023 – today" />
      </div>
      <div>
        <label class="adm-label" for="year_start">Mes de inicio, para ordenar</label>
        <input id="year_start" data-f="year_start" class="adm-input" value={p.yearStart} placeholder="2023-03" pattern="\d{4}-\d{2}" />
        <p class="adm-hint">Formato AAAA-MM.</p>
      </div>
      <div>
        <label class="adm-label" for="city">Ciudad o lugar</label>
        <input id="city" data-f="city" class="adm-input" value={p.city} />
      </div>
      <div class="flex flex-col justify-end gap-3">
        <label class="flex items-center gap-3 text-base"><input type="checkbox" data-f="featured" class="h-5 w-5" checked={Boolean(p.featured)} /> Destacar en la home (solo uno a la vez)</label>
        <label class="flex items-center gap-3 text-base"><input type="checkbox" data-f="published" class="h-5 w-5" checked={p.published !== false} /> Mostrar en la web</label>
      </div>
      <div class="lg:col-span-2">
        <label class="adm-label" for="summary">Resumen</label>
        <textarea id="summary" data-f="summary" class="adm-input !min-h-[96px]">{p.summary}</textarea>
        <p class="adm-hint">Una o dos frases. Aparece en la tarjeta del proyecto.</p>
      </div>
      <div class="lg:col-span-2">
        <label class="adm-label" for="intro">Texto de introducción</label>
        <textarea id="intro" data-f="intro" class="adm-input">{p.intro ?? ''}</textarea>
      </div>
      <div class="lg:col-span-2">
        <label class="adm-label" for="body">Texto principal</label>
        <textarea id="body" data-f="body" class="adm-input !min-h-[140px]">{p.body ?? ''}</textarea>
        <p class="adm-hint">Separa los párrafos con una línea en blanco.</p>
      </div>
      <div class="lg:col-span-2">
        <label class="adm-label" for="vision">Visión</label>
        <textarea id="vision" data-f="vision" class="adm-input">{p.vision ?? ''}</textarea>
      </div>
    </div>

    <div class="adm-card mt-6 flex flex-col gap-4 p-6" id="videos-card">
      <h2 class="text-xl font-medium">Vídeos</h2>
      <p class="adm-hint !mt-0">Pega la dirección de un vídeo de YouTube o Vimeo. Saldrá en la página del proyecto como un reproductor, que solo se carga cuando la persona pulsa play.</p>
      <div class="flex flex-col gap-2" id="video-rows">
        {(p.videos ?? []).map((x) => (
          <div class="grid grid-cols-[1fr_auto] gap-2 sm:grid-cols-[240px_1fr_auto]" data-video-row>
            <input class="adm-input col-span-2 sm:col-span-1" data-vt value={x.title} aria-label="Título del vídeo" placeholder="Título (opcional)" />
            <input class="adm-input" data-vu value={x.url} aria-label="Dirección del vídeo" placeholder="https://www.youtube.com/watch?v=…" />
            <button type="button" class="adm-btn !min-h-[46px] !px-3" data-video-remove aria-label="Quitar vídeo">✕</button>
          </div>
        ))}
      </div>
      <button type="button" class="adm-btn self-start" id="video-add">+ Añadir vídeo</button>
    </div>

    <div class="adm-card mt-6 flex flex-col gap-4 p-6" id="links-card">
      <h2 class="text-xl font-medium">Enlaces para saber más</h2>
      <p class="adm-hint !mt-0">Artículos, páginas de prensa o vídeos del proyecto. Salen como botones en la página del proyecto. Por ejemplo: «Read more» con la dirección del artículo.</p>
      <div class="flex flex-col gap-2" id="link-rows">
        {(p.links ?? []).map((x) => (
          <div class="grid grid-cols-[1fr_auto] gap-2 sm:grid-cols-[200px_1fr_auto]" data-link-row>
            <input class="adm-input col-span-2 sm:col-span-1" data-ll value={x.label} aria-label="Texto del botón" placeholder="Read more" />
            <input class="adm-input" data-lu value={x.url} aria-label="Enlace" placeholder="https://" />
            <button type="button" class="adm-btn !min-h-[46px] !px-3" data-link-remove aria-label="Quitar enlace">✕</button>
          </div>
        ))}
      </div>
      <button type="button" class="adm-btn self-start" id="link-add">+ Añadir enlace</button>
    </div>

    <div class="adm-card mt-6 flex flex-col gap-4 p-6" id="stats-card">
      <h2 class="text-xl font-medium">Cifras del proyecto</h2>
      <p class="adm-hint !mt-0">Los números que aparecen en la página del proyecto. Escribe el valor como debe verse, por ejemplo «2,400» o «200+». Si no añades ninguna, el bloque no se muestra.</p>
      <div class="flex flex-col gap-2" id="stat-rows">
        {(p.stats ?? []).map((x) => (
          <div class="grid grid-cols-[110px_1fr_auto] gap-2" data-stat>
            <input class="adm-input" data-sn value={x.n} aria-label="Valor" placeholder="2,400" />
            <input class="adm-input" data-sl value={x.label} aria-label="Etiqueta" placeholder="Asistentes" />
            <button type="button" class="adm-btn !min-h-[46px] !px-3" data-stat-remove aria-label="Quitar cifra">✕</button>
          </div>
        ))}
      </div>
      <button type="button" class="adm-btn self-start" id="stat-add">+ Añadir cifra</button>
      <div>
        <label class="adm-label" for="stats_note">Nota bajo las cifras</label>
        <input id="stats_note" data-f="stats_note" class="adm-input" value={p.statsNote ?? ''} placeholder="Global Women in Music, 2023–2026" />
      </div>
    </div>

    <div class="adm-card mt-6 flex flex-col gap-6 p-6" id="partner-card">
      <div>
        <h2 class="text-xl font-medium">Bloque «Hazte socio»</h2>
        <p class="adm-hint">Franja azul al final de la página con una invitación a colaborar. Si dejas vacíos el título y el texto, no se muestra.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div><label class="adm-label" for="pb-eyebrow">Etiqueta pequeña</label><input id="pb-eyebrow" data-pb="eyebrow" class="adm-input" value={pb?.eyebrow ?? ''} placeholder="Partner with us" /></div>
        <div></div>
        <div><label class="adm-label" for="pb-title">Título</label><input id="pb-title" data-pb="title" class="adm-input" value={pb?.title ?? ''} /></div>
        <div><label class="adm-label" for="pb-accent">Parte del título en color</label><input id="pb-accent" data-pb="titleAccent" class="adm-input" value={pb?.titleAccent ?? ''} /></div>
      </div>
      <div><label class="adm-label" for="pb-text">Texto</label><textarea id="pb-text" data-pb="text" class="adm-input">{pb?.text ?? ''}</textarea></div>
      <div>
        <label class="adm-label" for="pb-benefits">Ventajas de ser socio</label>
        <textarea id="pb-benefits" data-pb="benefits" class="adm-input !min-h-[120px]">{(pb?.benefits ?? []).join('\n')}</textarea>
        <p class="adm-hint">Una por línea.</p>
      </div>
      <div class="max-w-[420px]"><PhotoField label="Foto" value={pb?.photo ?? null} ratio="4 / 3" focus={false} /></div>
    </div>
  </section>

  <section data-panel="ediciones" hidden={tab !== 'ediciones'} class="mt-8">
    <div class="grid items-start gap-6 lg:grid-cols-[240px_1fr]">
      <div class="adm-card flex gap-1 overflow-x-auto p-2 lg:block" id="ed-list">
        {editions.map((e) => (
          <button type="button" data-ed={e.year} aria-pressed={e.year === selected?.year} class="adm-ed">
            <span class="font-medium" data-ed-label>{e.year}</span>
            <span class="text-sm opacity-80">{e.upcoming ? 'Próxima' : e.event || `Edición ${e.number}`}</span>
          </button>
        ))}
        <button type="button" id="ed-new" class="adm-btn flex-none !border-dashed lg:mt-2 lg:w-full">+ Nueva edición</button>
      </div>
      <div id="ed-forms">
        <p class="adm-card p-8 text-center text-ink-muted" id="ed-none" hidden={editions.length > 0}>Este proyecto no tiene ediciones. Sirven para proyectos que se repiten cada año, con su sede, director y line-up.</p>
        {editions.map((e) => <EditionForm e={e} hidden={e.year !== selected?.year} />)}
      </div>
    </div>
    <datalist id="people-list">{people.map((x) => <option value={x.name}></option>)}</datalist>
    <script type="application/json" id="people-map" set:html={JSON.stringify(Object.fromEntries(people.map((x) => [x.name.trim().toLowerCase(), { slug: x.slug, name: x.name }])))} />
    <template id="tpl-edition"><EditionForm hidden /></template>
  </section>

  <section data-panel="fotos" hidden={tab !== 'fotos'} class="mt-8 flex flex-col gap-6">
    <div class="adm-card p-6">
      <h2 class="text-xl font-medium">Portada y cabecera</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-2">
        <PhotoField label="Portada (tarjeta del proyecto)" value={p.cover} ratio="16 / 10" />
        <PhotoField label="Cabecera (página del proyecto)" value={p.hero ?? null} ratio="16 / 10" />
      </div>
    </div>
    <div class="adm-card p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-medium">Galería</h2>
        <button class="adm-btn" type="button" id="gal-add">+ Añadir foto</button>
      </div>
      <p class="adm-hint mt-2">Todas las fotos se muestran con el mismo tamaño en la web.</p>
      <p class="adm-hint mt-3" id="gal-empty" hidden={gallery.length > 0}>Este proyecto no tiene galería.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="gal">
        {gallery.map((g) => (
          <div class="rounded-lg border border-line p-3" data-gal>
            <PhotoField value={g} ratio="4 / 3" focus={false} />
            <div class="mt-3 flex justify-end">
              <button type="button" class="adm-btn !min-h-[40px]" data-gal-remove aria-label="Quitar foto">✕</button>
            </div>
          </div>
        ))}
      </div>
      <template id="tpl-gal">
        <div class="rounded-lg border border-line p-3" data-gal>
          <PhotoField ratio="4 / 3" focus={false} />
          <div class="mt-3 flex justify-end">
            <button type="button" class="adm-btn !min-h-[40px]" data-gal-remove aria-label="Quitar foto">✕</button>
          </div>
        </div>
      </template>
    </div>
    <div class="adm-card flex flex-col gap-6 p-6" id="doc">
      <h2 class="text-xl font-medium">Documental</h2>
      <p class="adm-hint !mt-0">Opcional. Si dejas vacíos el título, el texto y el enlace, la web no muestra la sección.</p>
      <div><label class="adm-label" for="doc-title">Título</label><input id="doc-title" data-d="title" class="adm-input" value={doc?.title ?? ''} /></div>
      <div><label class="adm-label" for="doc-text">Texto</label><textarea id="doc-text" data-d="text" class="adm-input">{doc?.text ?? ''}</textarea></div>
      <div><label class="adm-label" for="doc-trailer">Enlace al tráiler</label><input id="doc-trailer" data-d="trailerUrl" class="adm-input" value={doc?.trailerUrl ?? ''} placeholder="https://" /></div>
      <div class="max-w-[420px]"><PhotoField label="Imagen del tráiler" value={doc?.poster ?? null} ratio="16 / 9" focus={false} /></div>
      <div>
        <p class="adm-label">Festivales</p>
        <div class="flex flex-col gap-2" id="fests">
          {(doc?.festivals ?? []).map((f) => (
            <div class="grid grid-cols-[1fr_auto] gap-2 sm:flex sm:items-center" data-fest>
              <input class="adm-input sm:max-w-[140px]" data-ft="date" value={f.date} aria-label="Fecha" />
              <button type="button" class="adm-btn col-start-2 row-start-1 !min-h-[46px] !px-3 sm:order-last" data-fest-remove aria-label="Quitar">✕</button>
              <input class="adm-input col-span-2 row-start-2 sm:col-auto sm:flex-1" data-ft="name" value={f.name} aria-label="Festival" />
              <input class="adm-input col-span-2 row-start-3 sm:col-auto sm:max-w-[200px]" data-ft="result" value={f.result} aria-label="Resultado" />
            </div>
          ))}
        </div>
        <button class="adm-btn mt-3" type="button" id="fest-add">+ Añadir festival</button>
      </div>
    </div>
  </section>

  <div class="adm-actions">
    <button class="adm-btn adm-btn-primary" type="submit">Guardar cambios</button>
    <a class="adm-btn" href="/admin/proyectos/">Cancelar</a>
    {!isNew && <button class="adm-btn adm-btn-danger" type="submit" formaction="/admin/api/projects/delete" formnovalidate id="delete" onclick="return confirm('¿Quitar este proyecto de la web con todas sus ediciones? No se puede deshacer.')"><span class="sm:hidden">Quitar</span><span class="hidden sm:inline">Quitar de la web</span></button>}
  </div>
  </form>

  <style is:global>
    .adm-tab { flex: none; padding: 12px 18px; border: 0; border-bottom: 3px solid transparent; background: none; font: inherit; font-size: 16px; color: var(--color-ink-muted); cursor: pointer; margin-bottom: -1px; }
    .adm-tab[aria-selected="true"] { color: var(--color-navy); font-weight: 500; border-bottom-color: var(--color-orange); }
    .adm-ed { display: flex; flex: none; min-width: 104px; flex-direction: column; gap: 2px; padding: 10px 14px; border: 0; border-radius: 8px; background: none; font: inherit; text-align: left; color: var(--color-ink); cursor: pointer; }
    @media (min-width: 1024px) { .adm-ed { width: 100%; } }
    .adm-linked { border-color: #2f8f5b; box-shadow: inset 3px 0 0 #2f8f5b; }
    .adm-ed:hover { background: var(--color-surface-soft); }
    .adm-ed[aria-pressed="true"] { background: var(--color-navy); color: #fff; }
    [hidden] { display: none !important; }
  </style>

  <script>
    const form = document.getElementById('project-form') as HTMLFormElement;
    const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
    const all = <T extends HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

    // Tabs
    const tabs = all('[data-tab]');
    const panels = all('[data-panel]');
    const show = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));

    // Line-up members typed with the exact name of someone in Personas are linked to that person.
    const peopleMap: Record<string, { slug: string; name: string }> = JSON.parse($('#people-map').textContent || '{}');
    const relink = (input: HTMLInputElement) => {
      const hit = peopleMap[input.value.trim().toLowerCase()];
      input.dataset.person = hit?.slug ?? '';
      input.classList.toggle('adm-linked', Boolean(hit));
      input.title = hit ? 'Enlazada con su ficha de Personas: sale con su foto' : input.value.trim() ? 'Sin ficha en Personas: sale sin foto' : '';
      const note = input.closest('[data-member]')?.querySelector<HTMLElement>('[data-link]');
      if (note) note.textContent = hit ? '✓ Con su ficha de Personas' : input.value.trim() ? 'Sin ficha en Personas: sale sin foto' : '';
    };
    all<HTMLInputElement>('[data-m="name"]').forEach(relink);

    // Editions
    const forms = $('#ed-forms');
    const list = $('#ed-list');
    const select = (key: string) => {
      all('[data-ed]', list).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ed === key)));
      all('[data-edform]', forms).forEach((f) => (f.hidden = f.dataset.edform !== key));
    };
    const refreshNone = () => { $('#ed-none').hidden = all('[data-edform]', forms).length > 0; };
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ed]');
      if (b) select(b.dataset.ed!);
    });
    $('#ed-new').addEventListener('click', () => {
      const key = 'new-' + Date.now();
      const f = ($('#tpl-edition') as HTMLTemplateElement).content.firstElementChild!.cloneNode(true) as HTMLElement;
      f.dataset.edform = key; forms.appendChild(f);
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'adm-ed'; b.dataset.ed = key;
      b.innerHTML = '<span class="font-medium" data-ed-label>Nueva</span><span class="text-sm opacity-80">Edición nueva</span>';
      list.insertBefore(b, $('#ed-new')); refreshNone(); select(key);
      $<HTMLInputElement>('[data-e="year"]', f).focus();
    });
    forms.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.m === 'name') { relink(t); return; }
      if (t.dataset.e !== 'year') return;
      const f = t.closest<HTMLElement>('[data-edform]')!;
      $('[data-ed-title]', f).textContent = t.value;
      const b = all('[data-ed]', list).find((x) => x.dataset.ed === f.dataset.edform);
      if (b) $('[data-ed-label]', b).textContent = t.value || 'Nueva';
    });
    forms.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('[data-remove]')) t.closest('[data-member]')?.remove();
      if (t.matches('[data-add]')) {
        const l = $('[data-lineup]', t.parentElement!);
        l.querySelector('[data-empty]')?.remove();
        const row = document.createElement('div');
        row.className = 'grid grid-cols-[1fr_auto] gap-2 sm:flex sm:items-center';
        row.setAttribute('data-member', '');
        row.innerHTML = '<input class="adm-input" list="people-list" data-m="name" data-person="" placeholder="Nombre" aria-label="Nombre" /><input class="adm-input col-span-2 row-start-2 sm:max-w-[200px]" data-m="role" placeholder="Función" aria-label="Función" /><button type="button" class="adm-btn col-start-2 row-start-1 !min-h-[46px] !px-3" data-remove aria-label="Quitar">✕</button><p class="adm-hint col-span-2 !mt-0 sm:hidden" data-link></p>';
        l.appendChild(row);
        row.querySelector('input')?.focus();
      }
      if (t.matches('[data-remove-edition]')) {
        if (!confirm('¿Quitar esta edición con su line-up? Se aplica al guardar.')) return;
        const f = t.closest<HTMLElement>('[data-edform]')!;
        all('[data-ed]', list).find((x) => x.dataset.ed === f.dataset.edform)?.remove();
        f.remove(); refreshNone();
        const next = all('[data-ed]', list)[0];
        if (next) select(next.dataset.ed!);
      }
    });

    // Gallery
    const gal = $('#gal');
    const galEmpty = () => { $('#gal-empty').hidden = all('[data-gal]', gal).length > 0; };
    $('#gal-add').addEventListener('click', () => {
      const n = ($('#tpl-gal') as HTMLTemplateElement).content.firstElementChild!.cloneNode(true) as HTMLElement;
      gal.appendChild(n); (window as any).uvPhotos(n); galEmpty();
      $<HTMLElement>('[data-photo-file]', n).click();
    });
    gal.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-gal-remove]');
      if (b) { b.closest('[data-gal]')!.remove(); galEmpty(); }
    });

    // Videos
    const videoRows = $('#video-rows');
    $('#video-add').addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-[1fr_auto] gap-2 sm:grid-cols-[240px_1fr_auto]';
      row.setAttribute('data-video-row', '');
      row.innerHTML = '<input class="adm-input col-span-2 sm:col-span-1" data-vt aria-label="Título del vídeo" placeholder="Título (opcional)" /><input class="adm-input" data-vu aria-label="Dirección del vídeo" placeholder="https://www.youtube.com/watch?v=…" /><button type="button" class="adm-btn !min-h-[46px] !px-3" data-video-remove aria-label="Quitar vídeo">✕</button>';
      videoRows.appendChild(row); row.querySelector<HTMLInputElement>('[data-vu]')?.focus();
    });
    videoRows.addEventListener('click', (e) => { (e.target as HTMLElement).closest('[data-video-remove]')?.closest('[data-video-row]')?.remove(); });

    // Links to read more
    const linkRows = $('#link-rows');
    $('#link-add').addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-[1fr_auto] gap-2 sm:grid-cols-[200px_1fr_auto]';
      row.setAttribute('data-link-row', '');
      row.innerHTML = '<input class="adm-input col-span-2 sm:col-span-1" data-ll value="Read more" aria-label="Texto del botón" placeholder="Read more" /><input class="adm-input" data-lu aria-label="Enlace" placeholder="https://" /><button type="button" class="adm-btn !min-h-[46px] !px-3" data-link-remove aria-label="Quitar enlace">✕</button>';
      linkRows.appendChild(row); row.querySelector<HTMLInputElement>('[data-lu]')?.focus();
    });
    linkRows.addEventListener('click', (e) => { (e.target as HTMLElement).closest('[data-link-remove]')?.closest('[data-link-row]')?.remove(); });

    // Project figures
    const statRows = $('#stat-rows');
    $('#stat-add').addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-[110px_1fr_auto] gap-2';
      row.setAttribute('data-stat', '');
      row.innerHTML = '<input class="adm-input" data-sn aria-label="Valor" placeholder="2,400" /><input class="adm-input" data-sl aria-label="Etiqueta" placeholder="Asistentes" /><button type="button" class="adm-btn !min-h-[46px] !px-3" data-stat-remove aria-label="Quitar cifra">✕</button>';
      statRows.appendChild(row); row.querySelector('input')?.focus();
    });
    statRows.addEventListener('click', (e) => { (e.target as HTMLElement).closest('[data-stat-remove]')?.closest('[data-stat]')?.remove(); });

    // Festivals
    const fests = $('#fests');
    $('#fest-add').addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-[1fr_auto] gap-2 sm:flex sm:items-center';
      row.setAttribute('data-fest', '');
      row.innerHTML = '<input class="adm-input sm:max-w-[140px]" data-ft="date" placeholder="Fecha" aria-label="Fecha" /><button type="button" class="adm-btn col-start-2 row-start-1 !min-h-[46px] !px-3 sm:order-last" data-fest-remove aria-label="Quitar">✕</button><input class="adm-input col-span-2 row-start-2 sm:col-auto sm:flex-1" data-ft="name" placeholder="Festival" aria-label="Festival" /><input class="adm-input col-span-2 row-start-3 sm:col-auto sm:max-w-[200px]" data-ft="result" placeholder="Resultado" aria-label="Resultado" />';
      fests.appendChild(row); row.querySelector('input')?.focus();
    });
    fests.addEventListener('click', (e) => { (e.target as HTMLElement).closest('[data-fest-remove]')?.closest('[data-fest]')?.remove(); });

    // Everything is sent as one JSON document: the database saves it in a single step.
    const photo = (root: ParentNode) => { const v = $<HTMLInputElement>('[data-photo-value]', root).value; return v ? JSON.parse(v) : null; };
    form.addEventListener('submit', (e) => {
      const submitter = (e as SubmitEvent).submitter as HTMLElement | null;
      if (submitter?.id === 'delete') return;
      const f: Record<string, unknown> = {};
      all<HTMLInputElement>('[data-f]').forEach((el) => { f[el.dataset.f!] = el.type === 'checkbox' ? el.checked : el.value; });
      const photos = all('[data-panel="fotos"] > .adm-card:first-child [data-photo]');
      f.cover = photo(photos[0]); f.hero = photo(photos[1]);
      f.gallery = all('[data-gal]', gal).map((g) => photo(g)).filter((g) => g && g.src).map(({ src, alt, pos, w, h }) => ({ src, alt, pos, w, h }));
      const d: Record<string, unknown> = {};
      all<HTMLInputElement>('[data-d]').forEach((el) => { d[el.dataset.d!] = el.value; });
      d.poster = photo($('#doc'));
      d.festivals = all('[data-fest]', fests).map((r) => ({ date: $<HTMLInputElement>('[data-ft="date"]', r).value, name: $<HTMLInputElement>('[data-ft="name"]', r).value, result: $<HTMLInputElement>('[data-ft="result"]', r).value }));
      f.documentary = d;
      f.videos = all('[data-video-row]', videoRows).map((r) => ({ title: $<HTMLInputElement>('[data-vt]', r).value, url: $<HTMLInputElement>('[data-vu]', r).value }));
      f.links = all('[data-link-row]', linkRows).map((r) => ({ label: $<HTMLInputElement>('[data-ll]', r).value, url: $<HTMLInputElement>('[data-lu]', r).value }));
      f.stats = all('[data-stat]', statRows).map((r) => ({ n: $<HTMLInputElement>('[data-sn]', r).value, label: $<HTMLInputElement>('[data-sl]', r).value }));
      const pbo: Record<string, unknown> = {};
      all<HTMLInputElement>('[data-pb]').forEach((el) => { pbo[el.dataset.pb!] = el.value; });
      pbo.benefits = String(pbo.benefits ?? '').split('\n');
      pbo.photo = photo($('#partner-card'));
      f.partner = pbo;
      f.editions = all('[data-edform]', forms).map((ef) => {
        const o: Record<string, unknown> = {};
        all<HTMLInputElement>('[data-e]', ef).forEach((el) => { o[el.dataset.e!] = el.type === 'checkbox' ? el.checked : el.value; });
        o.lineup = all('[data-member]', ef).map((m) => { const n = $<HTMLInputElement>('[data-m="name"]', m); return { person: n.dataset.person ?? '', name: n.value, role: $<HTMLInputElement>('[data-m="role"]', m).value }; });
        return o;
      });
      $<HTMLInputElement>('#payload').value = JSON.stringify(f);
    });
  </script>
</AdminLayout>
