---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getProjects } from '../../../lib/content';
const projects = await getProjects();
---
<AdminLayout title="Proyectos" current="proyectos">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow text-ink-muted">Proyectos</p>
      <h1 class="adm-h1 mt-2">{projects.length} proyectos</h1>
    </div>
    <a href="/admin/proyectos/nuevo/" class="adm-btn adm-btn-primary">+ Añadir proyecto</a>
  </div>
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <label for="q" class="sr-only">Buscar</label>
    <input id="q" class="adm-input max-w-[320px]" type="search" placeholder="Buscar proyecto" />
    <div class="flex gap-2" role="group" aria-label="Filtrar por estado">
      <button class="adm-btn !min-h-[38px] !bg-navy !text-white" type="button">Todos</button>
      <button class="adm-btn !min-h-[38px]" type="button">En marcha</button>
      <button class="adm-btn !min-h-[38px]" type="button">Pasados</button>
    </div>
  </div>
  <div class="adm-card mt-6">
    {projects.map((p) => (
      <a href={`/admin/proyectos/${p.slug}/`} class="adm-row hover:no-underline">
        <span class="grid h-12 w-16 flex-none place-items-center rounded-md bg-placeholder text-xs text-placeholder-line">{p.cover ? 'foto' : '—'}</span>
        <span class="min-w-0 flex-1">
          <span class="block truncate font-medium">{p.title}</span>
          <span class="block truncate text-sm text-ink-muted">{p.dateLabel}{p.city ? ` · ${p.city}` : ''}</span>
        </span>
        {p.editions && <span class="adm-pill hidden sm:inline-flex">{p.editions.filter((e) => !e.upcoming).length} ediciones</span>}
        <span class={`adm-pill ${p.status === 'ongoing' ? 'adm-pill-ok' : ''}`}>{p.status === 'ongoing' ? 'En marcha' : 'Pasado'}</span>
        <span aria-hidden="true" class="text-ink-muted">›</span>
      </a>
    ))}
  </div>
</AdminLayout>
