---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSections } from '../../../admin/sections';
import { createClient, supabaseConfigured } from '../../../lib/supabase';

const s = (await getSections(supabaseConfigured() ? createClient(Astro.request, Astro.cookies) : undefined))[Astro.params.section ?? ''];
if (!s) return Astro.redirect('/admin/inicio/');
const isNew = Astro.params.id === 'nuevo';
const row = s.rows.find((r) => r.id === Astro.params.id);
if (!isNew && !row) return Astro.redirect(`/admin/${s.slug}/`);
const v = row?.values ?? {};
const errors: Record<string, string> = { faltan: 'Faltan campos obligatorios.', enlace: 'El enlace debe empezar por https://', fecha: 'La fecha de orden debe tener el formato AAAA-MM, por ejemplo 2025-08.', guardar: 'No se pudo guardar. Inténtalo de nuevo en un momento.', quitar: 'No se pudo quitar. Inténtalo de nuevo en un momento.' };
const error = errors[Astro.url.searchParams.get('error') ?? ''];
---
<AdminLayout title={isNew ? `Nuevo ${s.singular}` : row!.title} current={s.slug}>
  <a href={`/admin/${s.slug}/`} class="text-sm">‹ {s.label}</a>
  <h1 class="adm-h1 mt-3">{isNew ? `Añadir ${s.singular}` : row!.title}</h1>
  {error && <p role="alert" class="adm-card mt-6 border-l-4 border-l-[#a33] p-4 text-[#a33]">{error}</p>}
  <form class="mt-8" method="post" action="/admin/api/content/save">
    <input type="hidden" name="section" value={s.slug} />
    <input type="hidden" name="id" value={isNew ? '' : row!.id} />
    <div class="adm-card grid gap-6 p-6 lg:grid-cols-2">
      {s.fields.map((f) => (
        <div class={f.type === 'textarea' ? 'lg:col-span-2' : ''}>
          {f.type === 'toggle' ? (
            <label class="flex items-center gap-3 text-base"><input type="checkbox" name={f.key} class="h-5 w-5" checked={Boolean(v[f.key])} /> {f.label}</label>
          ) : (
            <>
              <label class="adm-label" for={f.key}>{f.label}</label>
              {f.type === 'textarea' && <textarea id={f.key} name={f.key} class="adm-input">{String(v[f.key] ?? '')}</textarea>}
              {f.type === 'text' && <input id={f.key} name={f.key} class="adm-input" value={String(v[f.key] ?? '')} placeholder={f.placeholder} />}
              {f.type === 'select' && <select id={f.key} name={f.key} class="adm-input">{f.options!.map((o) => <option value={o.v} selected={o.v === v[f.key]}>{o.l}</option>)}</select>}
            </>
          )}
          {f.hint && <p class="adm-hint">{f.hint}</p>}
        </div>
      ))}
    </div>
    <div class="adm-actions">
      <button class="adm-btn adm-btn-primary" type="submit">Guardar cambios</button>
      <a class="adm-btn" href={`/admin/${s.slug}/`}>Cancelar</a>
      {!isNew && <button class="adm-btn adm-btn-danger" type="submit" formaction="/admin/api/content/delete" formnovalidate onclick="return confirm('¿Quitar de la web? No se puede deshacer.')"><span class="sm:hidden">Quitar</span><span class="hidden sm:inline">Quitar de la web</span></button>}
    </div>
  </form>
</AdminLayout>
