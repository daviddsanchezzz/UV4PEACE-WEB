---
import AdminLayout from '../../layouts/AdminLayout.astro';
const changes = [
  { kind: 'Editada', what: 'Persona', name: 'Vesna Šouc', detail: 'Cargo: «Guest conductor» → «Directora invitada»' },
  { kind: 'Nueva', what: 'Edición', name: 'Global Women in Music · 2027', detail: 'Fecha: 12 mar 2027 · Sede sin confirmar' },
  { kind: 'Editada', what: 'Foto', name: 'Tim Ries', detail: 'Nueva foto y encuadre' },
];
---
<AdminLayout title="Publicar" current="">
  <p class="eyebrow text-ink-muted">Publicar</p>
  <h1 class="adm-h1 mt-2">3 cambios listos para la web</h1>
  <p class="mt-3 max-w-[60ch] text-ink-muted">Hasta que publiques, quien visite la web seguirá viendo la versión anterior. Tarda cerca de un minuto en verse.</p>

  <div class="adm-card mt-8">
    {changes.map((c) => (
      <div class="adm-row items-start">
        <span class={`adm-pill mt-0.5 ${c.kind === 'Nueva' ? 'adm-pill-ok' : ''}`}>{c.kind}</span>
        <div class="min-w-0 flex-1">
          <p class="font-medium">{c.name}</p>
          <p class="adm-hint !mt-0.5">{c.what} · {c.detail}</p>
        </div>
        <button type="button" class="text-sm">Deshacer</button>
      </div>
    ))}
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <button id="go" type="button" class="adm-btn adm-btn-primary !min-h-[52px] !px-8 !text-base">Publicar ahora</button>
    <a href="/" target="_blank" rel="noopener" class="text-sm">Ver la web actual</a>
    <p id="done" class="adm-pill adm-pill-ok !text-sm" hidden>Publicado. La web se actualiza en un minuto.</p>
  </div>
  <script>
    document.getElementById('go')?.addEventListener('click', () => {
      (document.getElementById('done') as HTMLElement).hidden = false;
    });
  </script>
</AdminLayout>
