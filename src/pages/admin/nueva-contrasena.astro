---
import '../../styles/global.css';
const error = Astro.url.searchParams.get('error');
const messages: Record<string, string> = {
  corta: 'La contraseña debe tener al menos 10 caracteres.',
  distinta: 'Las dos contraseñas no coinciden.',
  fallo: 'No se ha podido cambiar la contraseña. Pide un enlace nuevo.',
};
const message = error ? messages[error] ?? '' : '';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nueva contraseña · Panel UV4PEACE</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="grid min-h-svh place-items-center bg-navy px-4 py-10 font-sans text-ink antialiased">
    <main class="w-full max-w-[420px] rounded-2xl bg-white p-8 shadow-xl sm:p-10">
      <img src="/logos/uv4peace-horizontal-color.svg" alt="United Voices 4 Peace" class="h-10 w-auto" />
      <h1 class="mt-8 text-[28px] font-medium leading-tight">Elige tu contraseña</h1>
      <p class="mt-2 text-ink-muted">Mínimo 10 caracteres. Mejor una frase que puedas recordar.</p>
      {message && <p role="alert" class="mt-6 rounded-lg bg-[#fdecec] px-4 py-3 text-sm text-[#8f2a2a]">{message}</p>}
      <form class="mt-8 flex flex-col gap-5" method="post" action="/admin/api/password">
        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium">Contraseña nueva</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required class="min-h-[48px] w-full rounded-lg border-[1.5px] border-line px-3.5 text-base" />
        </div>
        <div>
          <label for="again" class="mb-1.5 block text-sm font-medium">Repítela</label>
          <input id="again" name="again" type="password" autocomplete="new-password" minlength="10" required class="min-h-[48px] w-full rounded-lg border-[1.5px] border-line px-3.5 text-base" />
        </div>
        <button class="btn btn-primary w-full" type="submit">Guardar contraseña</button>
      </form>
    </main>
  </body>
</html>
