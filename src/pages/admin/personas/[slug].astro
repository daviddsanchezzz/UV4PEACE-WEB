---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PhotoField from '../../../components/admin/PhotoField.astro';
import { getPeople, getProjects, type Person } from '../../../lib/content';
import { createClient, supabaseConfigured } from '../../../lib/supabase';

const db = supabaseConfigured() ? createClient(Astro.request, Astro.cookies) : undefined;
const [people, projects] = await Promise.all([getPeople(db), getProjects(db)]);
const { slug } = Astro.params;
const isNew = slug === 'nueva';
const found = people.find((p) => p.slug === slug);
if (!isNew && !found) return Astro.redirect('/admin/personas/');
const p: Person = found ?? { slug: '', name: '', role: '', city: '', group: 'team', photo: null, bio: '', website: '', order: people.length + 1, published: true };
const groups = [
  { v: 'team', l: 'Equipo' }, { v: 'board', l: 'Junta' }, { v: 'ambassador', l: 'Embajadora' }, { v: 'artist', l: 'Artista de un proyecto' },
];
const editionOptions = projects.flatMap((x) => (x.editions ?? []).map((e) => ({ v: `${x.slug}|${e.year}`, l: `${x.title} · ${e.year}` })));
const errors: Record<string, string> = { faltan: 'Faltan el nombre o el grupo.', enlace: 'El sitio web debe empezar por https://', foto: 'La foto no es válida. Súbela de nuevo.', guardar: 'No se pudo guardar. Inténtalo de nuevo en un momento.', quitar: 'No se pudo quitar. Inténtalo de nuevo en un momento.' };
const error = errors[Astro.url.searchParams.get('error') ?? ''];
---
<AdminLayout title={isNew ? 'Nueva persona' : p.name} current="personas">
  <a href="/admin/personas/" class="text-sm">‹ Todas las personas</a>
  <h1 class="adm-h1 mt-3">{isNew ? 'Añadir persona' : p.name}</h1>
  {error && <p role="alert" class="adm-card mt-6 border-l-4 border-l-[#a33] p-4 text-[#a33]">{error}</p>}

  <form class="mt-8 grid gap-8 lg:grid-cols-[1fr_340px]" method="post" action="/admin/api/people/save">
    <input type="hidden" name="id" value={isNew ? '' : p.slug} />
    <div class="min-w-0"><div class="adm-card flex flex-col gap-6 p-6">
      <div>
        <label class="adm-label" for="name">Nombre</label>
        <input id="name" name="name" required class="adm-input" value={p.name} />
      </div>
      <div>
        <label class="adm-label" for="role">Cargo o descripción</label>
        <input id="role" name="role" class="adm-input" value={p.role} />
        <p class="adm-hint">Aparece debajo del nombre, por ejemplo «Compositora» o «Directora invitada».</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="adm-label" for="group">¿Dónde aparece?</label>
          <select id="group" name="group" class="adm-input">
            {groups.map((g) => <option value={g.v} selected={g.v === p.group}>{g.l}</option>)}
          </select>
        </div>
        <div>
          <label class="adm-label" for="city">Ciudad</label>
          <input id="city" name="city" class="adm-input" value={p.city} />
        </div>
      </div>
      <div id="artist-box" hidden={p.group !== 'artist'}>
        <label class="adm-label" for="proj">Proyecto y edición</label>
        <select id="proj" name="project" class="adm-input">
          <option value="">— Ninguno —</option>
          {editionOptions.map((o) => <option value={o.v} selected={o.v === `${p.project}|${p.edition}`}>{o.l}</option>)}
        </select>
        <p class="adm-hint">Las artistas de la edición 2026 de Global Women in Music salen en la página People.</p>
      </div>
      <div>
        <label class="adm-label" for="bio">Biografía</label>
        <textarea id="bio" name="bio" class="adm-input">{p.bio}</textarea>
        <p class="adm-hint">Entre 200 y 300 caracteres queda bien en la tarjeta. Opcional: si la dejas vacía, la tarjeta solo muestra nombre y cargo.</p>
      </div>
      <div>
        <label class="adm-label" for="web">Sitio web</label>
        <input id="web" name="website" class="adm-input" value={p.website} placeholder="https://" />
      </div>
      <label class="flex items-center gap-3 text-base"><input type="checkbox" name="published" class="h-5 w-5" checked={p.published !== false} /> Mostrar en la web</label>
      {!isNew && <button class="adm-btn self-start !border-transparent !px-0 !text-[#a33] hover:!bg-transparent hover:underline" type="submit" formaction="/admin/api/people/delete" formnovalidate onclick="return confirm('¿Quitar de la web? No se puede deshacer.')">Quitar de la web</button>}
    </div>
    <div class="adm-actions">
      <button class="adm-btn adm-btn-primary" type="submit">Guardar cambios</button>
      <a class="adm-btn" href="/admin/personas/">Cancelar</a>
    </div>
    </div>

    <aside class="flex flex-col gap-6">
      <div class="adm-card p-5">
        <PhotoField name="photo" label="Foto" value={p.photo} />
      </div>
    </aside>
  </form>

  <script>
    const group = document.getElementById('group') as HTMLSelectElement;
    const box = document.getElementById('artist-box')!;
    group.addEventListener('change', () => { box.hidden = group.value !== 'artist'; });
  </script>
</AdminLayout>
