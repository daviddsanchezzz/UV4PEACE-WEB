---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { getProject, getSettings } from '../lib/content';
const settings = await getSettings();

const gwimPartner = (await getProject('global-women-in-music'))!.partner!;
---
<Base title="Get Involved" current="get-involved" description="Partner with us, propose a project, donate or spread the word.">
  <PageHeader eyebrow="Get involved" title={['Add your', 'voice']} lede="Four ways to help more artists reach the stages where decisions are made." />

  <!-- Partner -->
  <section id="partner" aria-labelledby="partner-h" class="bg-navy text-white">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,480px),1fr))]">
      <div class="relative min-h-[clamp(380px,46vw,720px)]"><Photo src="08-partners-photocall_IMG_5478.jpg" alt="Guests at the Global Women in Music photocall in front of the partners' backdrop" pos="50% 35%" sizes="(min-width:1024px) 50vw, 100vw" loading="eager" /></div>
      <div data-reveal class="max-w-[680px] px-[clamp(24px,5vw,88px)] py-[clamp(56px,7vw,112px)]">
        <div class="eyebrow text-sky">For foundations &amp; institutions</div>
        <h2 id="partner-h" class="t-h1 mt-4">Partner with us</h2>
        <p class="body mt-5">Put your institution's name behind live music that advances visibility, representation and dialogue on the global decision-makers' stage.</p>
        <div class="eyebrow mt-10 text-line">Global Women in Music 2027 · partner benefits</div>
        <ul class="mt-4 border-t border-white/20">
          {gwimPartner.benefits.map((b) => <li class="flex gap-3.5 border-b border-white/20 py-3.5 text-[17px] leading-normal"><span aria-hidden="true" class="mt-[9px] h-2 w-2 flex-none rounded-full bg-sky"></span>{b}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3.5">
          <Button href={settings.partnerMailto}>Start a partnership</Button>
          <Button href="/projects/global-women-in-music/#partner" variant="light">See GWIM 2027</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Propose -->
  <section id="propose" aria-labelledby="propose-h" class="wrap section-y grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(40px,6vw,96px)]">
    <div data-reveal>
      <div class="eyebrow text-sky-text">For artists &amp; organisations</div>
      <h2 id="propose-h" class="t-h1 mt-4">Propose a project</h2>
      <p class="body mt-5 max-w-[540px] text-ink-muted">Bring us an idea that uses music or the arts to build bridges. Tell us who it brings together, where it happens and what you need from us.</p>
      <Button href={settings.proposalMailto} variant="tertiary" class="mt-8">Send a proposal</Button>
    </div>
    <figure data-reveal class="relative m-0 aspect-[4/3] overflow-hidden rounded-card bg-placeholder">
      <Photo src="10-propose-partitura_IMG_5272.jpg" alt="Scores on a music stand: &quot;Going Home&quot; by Aida Saco and &quot;Tierra Pura&quot; by Valerie Naranjo" pos="45% 60%" sizes="(min-width:1024px) 600px, 100vw" />
    </figure>
  </section>

  <ContactForm />

  <!-- Donate + Spread -->
  <section class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[clamp(20px,2.4vw,28px)] pb-[clamp(72px,10vw,140px)]">
    <article id="donate" data-reveal class="card-lift flex flex-col overflow-hidden rounded-card border border-line bg-white">
      <div class="relative aspect-[16/10] bg-placeholder"><Photo src="09-donate-abrazo_IMG_5435.jpg" alt="Two artists embracing on stage after the concert" pos="50% 30%" sizes="(min-width:1024px) 640px, 100vw" /></div>
      <div class="flex flex-1 flex-col p-[clamp(24px,3vw,40px)]">
        <h2 class="t-h2">Donate</h2>
        <p class="body mt-3 flex-1 text-ink-muted">Every gift brings more women composers to the stage.</p>
        <div class="mt-4 text-[13px] font-medium text-sky-text">{site.seal}</div>
        <Button href="/donate/" class="mt-6 self-start">Donate via PayPal</Button>
      </div>
    </article>
    <article id="spread" data-reveal class="card-lift flex flex-col overflow-hidden rounded-card border border-line bg-white">
      <div class="relative aspect-[16/10] bg-placeholder"><Photo src="11-spread-the-word_IMG_5553.jpg" alt="Audience and artists sharing the moment after the concert" sizes="(min-width:1024px) 640px, 100vw" /></div>
      <div class="flex flex-1 flex-col p-[clamp(24px,3vw,40px)]">
        <h2 class="t-h2">Spread the word</h2>
        <p class="body mt-3 flex-1 text-ink-muted">Share our concerts and stories with your community.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" data-share class="btn btn-tertiary btn-sm">Share this page</button>
          {settings.social.filter((s) => s.href).map((s) => <Button href={s.href} variant="tertiary" size="sm">{s.label}</Button>)}
        </div>
        <span data-share-ok hidden class="mt-3 text-sm text-sky-text">Link copied.</span>
      </div>
    </article>
  </section>

  <NewsletterForm />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
    const data = { title: 'United Voices 4 Peace', url: location.origin };
    if (navigator.share) { try { await navigator.share(data); } catch {} return; }
    await navigator.clipboard?.writeText(data.url);
    const ok = b.closest('article')?.querySelector<HTMLElement>('[data-share-ok]');
    if (ok) ok.hidden = false;
  }));
</script>
