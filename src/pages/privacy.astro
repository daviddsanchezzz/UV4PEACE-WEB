---
export const prerender = true;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<Base title="Privacy policy">
  <PageHeader eyebrow="Legal" title={['Privacy policy']} />
  <section class="wrap pb-[clamp(72px,10vw,128px)]">
    <div class="max-w-[720px]">
      <h2 class="t-h3">Data controller</h2>
      <ul class="body mt-3 text-ink-muted">{site.legalEntities.map((l) => <li>{l}</li>)}</ul>
      <p class="body mt-3 text-ink-muted">Contact: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>
