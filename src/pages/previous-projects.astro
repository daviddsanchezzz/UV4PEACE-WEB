---
import Base from '../layouts/Base.astro';
import ClassicPage from '../components/classic/ClassicPage.astro';
import ProjectBlock from '../components/classic/ProjectBlock.astro';
import { previousProjects } from '../data/classic';
---
<Base title="Previous projects" current="previous">
  <ClassicPage title="Previous projects">
    <div class="flex flex-col gap-14">
      {previousProjects.map((p, i) => <ProjectBlock project={p} flip={i % 2 === 1} />)}
    </div>
  </ClassicPage>
</Base>
