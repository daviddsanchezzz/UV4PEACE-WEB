---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ClassicPage from '../components/classic/ClassicPage.astro';
import { getPress, getTestimonials, getMedia, getPressArchive } from '../lib/content';
import { languageLabel, type Language } from '../data/press';
import docPoster from '../assets/posters/gwim-documentary.png';
import heroPhoto from '../assets/fotos/media-hero-gwim-photocall.jpg';

const [press, testimonials, media, archive] = await Promise.all([getPress(), getTestimonials(), getMedia(), getPressArchive()]);

// Recognition: dated items grouped by year (newest first); undated ones (certificates, seals) go last.
const dated = press.filter((a) => /^[A-Za-z]{3} \d{4}$/.test(a.dateLabel)).sort((a, b) => b.date.localeCompare(a.date));
const standing = press.filter((a) => !dated.includes(a));
const years = [...new Set(dated.map((a) => a.date.slice(0, 4)))];
const kindLabel: Record<string, string> = { award: 'Award', honour: 'Honour', selection: 'Official selection', nomination: 'Nomination', seal: 'Seal' };
const kindClass: Record<string, string> = {
  award: 'bg-orange text-navy-deep',
  honour: 'bg-navy text-white',
  selection: 'bg-sky/15 text-sky-text',
  nomination: 'bg-turquoise/15 text-turquoise',
  seal: 'bg-navy text-white',
};

const quotes = testimonials.filter((t) => t.published).sort((a, b) => a.order - b.order);

// Media coverage: "Outlet — Headline (2026)" is split into its parts; the year comes from the label or the link.
const coverage = media.coverage.map((m) => {
  const [outlet, ...rest] = m.outlet.split(' — ');
  const headlineRaw = rest.join(' — ');
  const year = headlineRaw.match(/\((20\d\d)\)$/)?.[1] ?? m.url.match(/(?<!\d)(20[12]\d)(?=(?:\d{2}|\d{4})?[/.-])/)?.[1] ?? '';
  return { ...m, name: outlet.trim(), headline: headlineRaw.replace(/\s*\(20\d\d\)$/, '').trim(), year };
}).sort((a, b) => (b.year || '0').localeCompare(a.year || '0'));
const langs = (['en', 'es', 'it', 'fr', 'ar', 'sr'] as Language[]).filter((l) => coverage.some((m) => m.language === l));
const featuredIn = ['Variety', 'Forbes', 'UN News', 'La Vanguardia', 'La Voce di New York', 'Télam'];
const stats = [
  { n: '50+', label: 'Media publications' },
  { n: String(langs.length), label: 'Languages' },
  { n: String(press.length), label: 'Awards, honours & selections' },
  { n: '2,400', label: 'Concert attendees since 2023' },
];
---
<Base title="Media & Recognition" current="press" bannerPhoto={heroPhoto} bannerPosition="50% 30%">
  <ClassicPage title="Media & Recognition">
    <p class="lede max-w-[760px] text-navy">
      Since our launch, United Voices 4 Peace has been recognised by public institutions, film festivals and the music industry, and our work has been covered by media around the world.
    </p>

    <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-card bg-line sm:grid-cols-4">
      {stats.map((s) => (
        <div class="flex flex-col bg-surface-soft p-5 sm:p-6">
          <dt class="order-2 mt-1 text-[15px] leading-snug text-ink-muted">{s.label}</dt>
          <dd class="order-1 text-3xl font-medium text-orange sm:text-4xl">{s.n}</dd>
        </div>
      ))}
    </dl>

    <!-- Recognition -->
    <section class="mt-[clamp(56px,7vw,96px)]" id="recognition">
      <h2 class="t-h2 text-navy">Recognition</h2>
      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
        <figure class="lg:sticky lg:top-28 lg:self-start">
          <Image src={docPoster} alt="Poster of the documentary Global Women in Music: Composers Rewriting the Score, with its festival laurels" class="w-full rounded-card border border-line" widths={[480, 720]} sizes="(min-width: 1024px) 40vw, 100vw" />
          <figcaption class="mt-3 text-[15px] leading-relaxed text-ink-muted">
            <span class="font-medium text-navy">Global Women in Music: Composers Rewriting the Score.</span> Our documentary, produced during the 2024 edition, premiered at Roosevelt House in March 2025 and continues on the festival circuit.
            <a href="http://bit.ly/4bm7IO7" target="_blank" rel="noopener" class="ml-1 whitespace-nowrap font-medium">Watch the trailer ↗</a>
          </figcaption>
        </figure>

        <div>
          {years.map((y) => (
            <div class="grid grid-cols-[64px_minmax(0,1fr)] gap-4 sm:grid-cols-[88px_minmax(0,1fr)] sm:gap-6">
              <div class="pt-5 text-2xl font-medium text-navy sm:text-3xl">{y}</div>
              <ol class="border-l border-line">
                {dated.filter((a) => a.date.startsWith(y)).map((a) => (
                  <li class="relative py-5 pl-6">
                    <span class="absolute -left-[5px] top-[30px] size-[9px] rounded-full bg-orange"></span>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-medium uppercase tracking-[0.1em] text-ink-muted">{a.dateLabel.slice(0, 3)}</span>
                      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium uppercase tracking-[0.08em]', kindClass[a.kind]]}>{kindLabel[a.kind]}</span>
                    </div>
                    <div class="mt-2 text-[19px] font-semibold leading-snug text-navy">{a.url ? <a href={a.url} target="_blank" rel="noopener">{a.title}</a> : a.title}</div>
                    {a.by && <div class="mt-1 text-[15px] leading-relaxed text-ink-muted">{a.by}</div>}
                  </li>
                ))}
              </ol>
            </div>
          ))}

          {standing.length > 0 && (
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              {standing.map((a) => (
                <div class="rounded-card bg-navy p-6 text-white">
                  <span class="text-xs font-medium uppercase tracking-[0.12em] text-orange">{kindLabel[a.kind]}</span>
                  <div class="mt-2 text-[18px] font-semibold leading-snug">{a.title}</div>
                  {a.by && <div class="mt-1 text-[15px] text-white/75">{a.by}</div>}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Voices of participants -->
    {quotes.length > 0 && (
      <section class="mt-[clamp(56px,7vw,96px)]" id="voices">
        <h2 class="t-h2 text-navy">In their words</h2>
        <p class="mt-3 max-w-[640px] text-base text-ink-muted">What the artists who have taken part in our projects say about the experience.</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {quotes.map((q) => (
            <figure class="flex flex-col rounded-card bg-surface-soft p-7 sm:p-9">
              <span aria-hidden="true" class="font-serif text-6xl leading-none text-orange">“</span>
              <blockquote class="-mt-3 text-lg font-light leading-relaxed text-navy sm:text-xl">{q.text}</blockquote>
              <figcaption class="mt-auto pt-6">
                <div class="font-medium text-navy">{q.who}</div>
                {q.caption && <div class="mt-0.5 text-[15px] text-ink-muted">{q.caption}</div>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Media coverage -->
    <section class="mt-[clamp(56px,7vw,96px)]" id="media">
      <h2 class="t-h2 text-navy">Media coverage</h2>

      <div class="mt-6 border-y border-line py-6">
        <div class="eyebrow text-ink-muted">Featured in</div>
        <ul class="mt-4 flex flex-wrap items-baseline gap-x-8 gap-y-3">
          {featuredIn.map((o) => <li class="text-xl font-semibold tracking-wide text-navy/80 sm:text-2xl">{o}</li>)}
        </ul>
      </div>

      {media.spoke && (
        <a href={media.spoke.url} target="_blank" rel="noopener" class="mt-8 flex flex-col gap-1 rounded-card border border-line p-6 no-underline transition hover:border-sky sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="eyebrow text-orange">Spoke about us</div>
            <div class="mt-2 text-xl font-semibold text-navy">{media.spoke.outlet}</div>
          </div>
          <span class="font-medium text-sky-text">Read the article ↗</span>
        </a>
      )}

      <div class="mt-8 flex flex-wrap gap-2" role="toolbar" aria-label="Filter by language" data-filters>
        <button type="button" data-lang="all" aria-pressed="true" class="chip">All <span>{coverage.length}</span></button>
        {langs.map((l) => (
          <button type="button" data-lang={l} aria-pressed="false" class="chip">{languageLabel[l]} <span>{coverage.filter((m) => m.language === l).length}</span></button>
        ))}
      </div>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-coverage>
        {coverage.map((m) => {
          const body = (
            <>
              <div class="flex items-center justify-between gap-3 text-xs font-medium uppercase tracking-[0.1em] text-ink-muted">
                <span>{languageLabel[m.language]}{m.year && ` · ${m.year}`}</span>
                {m.url ? <span aria-hidden="true" class="text-base text-sky-text">↗</span> : <span class="normal-case tracking-normal">link coming soon</span>}
              </div>
              <div class="mt-3 text-lg font-semibold leading-snug text-navy">{m.name}</div>
              {m.headline && <div class="mt-1 text-[15px] leading-relaxed text-ink-muted">{m.headline}</div>}
            </>
          );
          return (
            <li data-lang={m.language}>
              {m.url
                ? <a href={m.url} target="_blank" rel="noopener" class="block h-full rounded-card border border-line bg-white p-5 no-underline transition hover:-translate-y-0.5 hover:border-sky">{body}</a>
                : <div class="h-full rounded-card border border-dashed border-line p-5">{body}</div>}
            </li>
          );
        })}
      </ul>

      {archive.length > 0 && (
        <div class="mt-12">
          <div class="eyebrow text-ink-muted">Earlier coverage, 2017–2018</div>
          <ol class="mt-3 border-t border-line">
            {archive.map((item) => (
              <li class="grid grid-cols-[84px_minmax(0,1fr)] gap-3 border-b border-line py-3.5 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-5">
                <div class="pt-0.5 text-sm font-medium uppercase tracking-[0.1em] text-sky-text">{item.date || '—'}</div>
                <div class="text-base leading-normal">
                  {item.title}
                  {item.links.map((l, i) => (
                    <>
                      {' '}{i === 0 ? '— ' : '· '}
                      {l.url ? <a href={l.url} target="_blank" rel="noopener">{l.label}</a> : <span class="text-ink-muted">{l.label}</span>}
                    </>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  </ClassicPage>
</Base>

<style>
  .chip { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--color-line); border-radius: 999px; padding: 6px 14px; font-size: 15px; color: var(--color-navy); background: #fff; cursor: pointer; }
  .chip span { font-size: 12px; color: var(--color-ink-muted); }
  .chip[aria-pressed='true'] { background: var(--color-navy); border-color: var(--color-navy); color: #fff; }
  .chip[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }
</style>

<script>
  const bar = document.querySelector('[data-filters]');
  const items = document.querySelectorAll<HTMLElement>('[data-coverage] > li');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-lang]');
    if (!btn) return;
    const lang = btn.dataset.lang;
    bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    items.forEach((li) => { li.hidden = lang !== 'all' && li.dataset.lang !== lang; });
  });
</script>
