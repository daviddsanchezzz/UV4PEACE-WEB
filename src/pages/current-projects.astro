---
import Base from '../layouts/Base.astro';
import ClassicPage from '../components/classic/ClassicPage.astro';
import ProjectBlock from '../components/classic/ProjectBlock.astro';
import { currentProjects } from '../data/classic';
---
<Base title="Current Projects" current="current">
  <ClassicPage title="Current Projects">
    <div class="flex flex-col gap-14">
      {currentProjects.map((p, i) => <ProjectBlock project={p} flip={i % 2 === 1} />)}
    </div>
    <a href="/previous-projects/" class="btn btn-tertiary mt-12">Previous projects</a>
  </ClassicPage>
</Base>
