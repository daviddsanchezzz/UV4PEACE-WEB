---
import Base from '../layouts/Base.astro';
import ClassicPage from '../components/classic/ClassicPage.astro';
import Rich from '../components/classic/Rich.astro';
import LogoCarousel from '../components/classic/LogoCarousel.astro';
import ProjectBlock from '../components/classic/ProjectBlock.astro';
import { homeIntro, homeProjects, successNumbers } from '../data/classic';
---
<Base current="home" bigHeader>
  <ClassicPage title="Home">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="text-[clamp(24px,2.8vw,38px)] font-medium uppercase leading-[1.15] tracking-[0.02em] text-navy text-balance">{homeIntro.heading}</h2>
        <p class="mt-8 flex max-w-[460px] items-center gap-4 rounded-card border border-line bg-surface-soft p-4 text-[15px] leading-snug text-navy">
          <img src="/un-emblem.png" alt="" width="56" height="56" class="size-14 flex-none rounded-lg" />
          <span>{homeIntro.unLine}</span>
        </p>
      </div>
      <div>
        <div class="body flex flex-col gap-4">
          {homeIntro.paragraphs.map((t, i) => (
            <>
              <Rich text={t} class={i === 0 ? 'lede text-navy' : undefined} />
              {t.includes('Sustainable Development Goals') && (
                <ul class="grid max-w-[480px] grid-cols-4 gap-2 sm:gap-3" aria-label="Focus Sustainable Development Goals">
                  {homeIntro.sdgs.map((g) => (
                    <li><img src={`/sdg/sdg-${g.n}.png`} alt={`Goal ${g.n}: ${g.label}`} width="160" height="160" loading="lazy" class="aspect-square w-full" /></li>
                  ))}
                </ul>
              )}
            </>
          ))}
        </div>
      </div>
    </div>

    <h2 class="t-h2 mt-20 text-navy">Partners</h2>
    <div class="mt-6"><LogoCarousel /></div>

    <section class="mt-20 rounded-card bg-surface-soft px-[clamp(24px,4vw,56px)] py-[clamp(32px,4vw,56px)]">
      <h2 class="t-h2 text-navy">Global Women in Music 2027</h2>
      <p class="lede mt-4 max-w-[820px] text-ink">We are excited to announce that the Global Women in Music 2027 concert, our fifth edition, is on the way. Stay tuned, it's coming soon!</p>
    </section>

    <section class="mt-20">
      <h2 class="t-h2 text-navy">Our Success in Numbers</h2>
      <dl class="mt-8 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {successNumbers.map((n) => (
          <div class="flex flex-col gap-2 bg-white p-6 lg:p-8">
            <dt class="order-2 text-[16px] leading-snug text-ink-muted">{n.label}</dt>
            <dd class="order-1 text-[clamp(34px,4vw,52px)] font-medium leading-none text-orange">{n.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <h2 class="t-h1 mt-24 text-navy">Our Current Projects</h2>
    <div class="mt-10 flex flex-col gap-14">
      {homeProjects.map((p, i) => <ProjectBlock project={p} level="h3" flip={i % 2 === 1} />)}
    </div>
    <a href="/projects/" class="btn btn-tertiary mt-12">Find out more on Current Projects</a>
  </ClassicPage>
</Base>
