---
import '../styles/global.css';
import Header from '../components/classic/ClassicHeader.astro';
import Footer from '../components/classic/ClassicFooter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getSettings } from '../lib/content';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import defaultShare from '../assets/fotos/14-home-hero-saludo-final_IMG_5460.jpg';
import { site } from '../data/site';

interface Props { title?: string; description?: string; current?: string; noindex?: boolean; bigHeader?: boolean; noBanner?: boolean; bannerPhoto?: ImageMetadata; bannerPosition?: string; bannerMobileOnly?: boolean; shareImage?: ImageMetadata; jsonLd?: Record<string, unknown> }
const {
  title,
  description = 'United Voices 4 Peace builds bridges between cultures, diplomacy and communities through music and the arts.',
  current,
  noindex = false,
  bigHeader = false,
  noBanner = false,
  bannerPhoto,
  bannerPosition,
  bannerMobileOnly = false,
  shareImage,
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · United Voices 4 Peace` : 'United Voices 4 Peace · Cultural diplomacy through music and the arts';
// Preview and project addresses on vercel.app must not compete with uv4peace.org in search results.
const previewHost = Astro.url.hostname.endsWith('.vercel.app');
// The picture shown when a page is shared (WhatsApp, LinkedIn, Facebook...): the page's own photo, else the Home one.
const og = await getImage({ src: shareImage ?? bannerPhoto ?? defaultShare, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = new URL(og.src, Astro.url.origin);
const { analyticsId } = await getSettings();
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || previewHost) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="United Voices 4 Peace" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#14365A" />
    <script is:inline>
      // An emailed invitation or recovery link may land on any page with the session in the address (#access_token=...).
      // Forward it to the page that stores it safely.
      if (location.hash.indexOf('access_token=') > -1 && /type=(invite|recovery)/.test(location.hash)) location.replace('/admin/auth/aceptar/' + location.hash);
    </script>
  </head>
  <body class="bg-surface font-sans text-ink antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header current={current} big={bigHeader} banner={!noBanner} photo={bannerPhoto} photoPosition={bannerPosition} mobileOnly={bannerMobileOnly} />
    <main id="main"><slot /></main>
    <Footer />
    {analyticsId && <CookieConsent measurementId={analyticsId} />}

    <script>
      // Gentle reveal on scroll. Respects prefers-reduced-motion.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -40px 0px' });
        els.forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) { el.classList.add('will-reveal'); io.observe(el); } });
        setTimeout(() => els.forEach((el) => el.classList.add('is-in')), 2500);
      }
    </script>
  </body>
</html>
