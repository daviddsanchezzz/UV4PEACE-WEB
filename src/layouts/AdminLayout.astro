---
// Admin shell for the content panel. Saved changes go live on the public site within about a minute.
import '../styles/global.css';

interface Props { title: string; current?: string }
const { title, current = '' } = Astro.props;

const nav = [
  { id: 'inicio', label: 'Inicio', href: '/admin/inicio/' },
  { id: 'proyectos', label: 'Proyectos', href: '/admin/proyectos/' },
  { id: 'personas', label: 'Personas', href: '/admin/personas/' },
  { id: 'newsletter', label: 'Newsletter', href: '/admin/newsletter/' },
  { id: 'prensa', label: 'Prensa', href: '/admin/prensa/' },
  { id: 'socios', label: 'Socios', href: '/admin/socios/' },
  { id: 'testimonios', label: 'Testimonios', href: '/admin/testimonios/' },
  { id: 'cifras', label: 'Cifras', href: '/admin/cifras/' },
  { id: 'ajustes', label: 'Ajustes', href: '/admin/ajustes/' },
];
const tabs = [nav[0], nav[1], nav[2], { id: 'mas', label: 'Más', href: '/admin/mas/' }];
const moreIds = ['mas', 'newsletter', 'prensa', 'socios', 'testimonios', 'cifras', 'ajustes'];
const tabActive = (id: string) => (id === 'mas' ? moreIds.includes(current) : current === id);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Panel UV4PEACE</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-surface-soft font-sans text-ink antialiased">
    <aside class="adm-side">
      <a href="/admin/inicio/" class="adm-brand" aria-label="Panel UV4PEACE">
        <img src="/logos/uv4peace-horizontal-white.svg" alt="" class="h-8 w-auto" />
        <span>Panel</span>
      </a>
      <nav class="adm-nav" aria-label="Secciones">
        {nav.map((n) => (
          <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <form method="post" action="/admin/api/logout" class="adm-logout"><button type="submit">Salir{Astro.locals.userEmail ? ` (${Astro.locals.userEmail})` : ''}</button></form>
      <a href="/" target="_blank" rel="noopener" class="adm-pub"><span>Ver la web</span></a>
    </aside>
    <main class="adm-main"><slot /></main>
    <nav class="adm-tabbar" aria-label="Navegación">
      {tabs.map((t) => (
        <a href={t.href} aria-current={tabActive(t.id) ? 'page' : undefined}>{t.label}</a>
      ))}
    </nav>
    <style is:global>
      .adm-side { position: sticky; top: 0; z-index: 20; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding: 10px 16px; background: var(--color-navy); color: #fff; }
      .adm-brand { display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; font-size: 13px; }
      .adm-brand:hover { color: #fff; text-decoration: none; }
      .adm-nav { display: none; }
      .adm-nav a { flex: none; padding: 8px 14px; border-radius: 9999px; color: #cfe0f1; font-size: 15px; }
      .adm-nav a:hover { background: rgba(255,255,255,.1); color: #fff; text-decoration: none; }
      .adm-nav a[aria-current] { background: #fff; color: var(--color-navy); font-weight: 500; }
      .adm-logout { display: none; }
      .adm-pub { margin-left: auto; min-height: 40px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 9999px; background: var(--color-orange); color: var(--color-navy); font-weight: 500; font-size: 14px; }
      .adm-pub:hover { background: var(--color-orange-hover); color: var(--color-navy); text-decoration: none; }
      .adm-pub b { display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 9999px; background: var(--color-navy); color: #fff; font-size: 12px; }
      .adm-tabbar { position: fixed; inset: auto 0 0; z-index: 30; display: grid; grid-template-columns: repeat(4, 1fr); padding: 6px 8px calc(6px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid var(--color-line); }
      .adm-tabbar a { padding: 10px 4px; border-radius: 10px; text-align: center; font-size: 13px; font-weight: 500; color: var(--color-ink-muted); }
      .adm-tabbar a:hover { text-decoration: none; color: var(--color-navy); }
      .adm-tabbar a[aria-current] { background: var(--color-surface-soft); color: var(--color-navy); }
      .adm-actions { position: sticky; bottom: calc(58px + env(safe-area-inset-bottom)); z-index: 10; display: flex; flex-wrap: wrap; gap: 10px; margin: 16px -16px 0; padding: 12px 16px; background: #fff; border-top: 1px solid var(--color-line); box-shadow: 0 -6px 12px -8px rgba(20,54,90,.25); }
      .adm-handle { cursor: grab; user-select: none; font-size: 20px; line-height: 1; color: var(--color-placeholder-line); }
      .adm-main { padding: 20px 16px 120px; min-width: 0; }
      @media (min-width: 1024px) {
        body { display: grid; grid-template-columns: 248px minmax(0, 1fr); align-items: start; }
        .adm-side { position: sticky; top: 0; height: 100vh; flex-direction: column; align-items: stretch; flex-wrap: nowrap; padding: 24px 16px; gap: 24px; }
        .adm-nav { display: flex; flex-direction: column; }
        .adm-tabbar { display: none; }
        .adm-actions { position: static; margin: 24px 0 0; padding: 0; background: none; border: 0; box-shadow: none; }
        .adm-nav a { border-radius: 8px; }
        .adm-logout { display: block; margin-top: auto; }
        .adm-logout button { width: 100%; padding: 8px 14px; border: 0; background: none; color: #cfe0f1; font: inherit; font-size: 14px; text-align: left; cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .adm-logout button:hover { color: #fff; }
        .adm-pub { margin: 0; justify-content: space-between; border-radius: 10px; padding: 12px 16px; }
        .adm-main { width: 100%; padding: 40px 48px 96px; }
      }
      .adm-card { background: #fff; border: 1px solid var(--color-line); border-radius: 12px; }
      .adm-h1 { font-size: clamp(26px, 3vw, 34px); font-weight: 500; line-height: 1.1; }
      .adm-label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 500; }
      .adm-hint { margin-top: 6px; font-size: 13px; color: var(--color-ink-muted); }
      .adm-input { width: 100%; min-height: 46px; padding: 10px 14px; border: 1.5px solid var(--color-line); border-radius: 8px; background: #fff; font: inherit; font-size: 16px; color: var(--color-ink); }
      textarea.adm-input { min-height: 120px; resize: vertical; line-height: 1.5; }
      .adm-input:focus { outline: none; border-color: var(--color-sky-text); box-shadow: 0 0 0 3px rgba(85,173,239,.3); }
      .adm-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 20px; border-radius: 9999px; border: 1.5px solid var(--color-navy); background: transparent; font: inherit; font-size: 15px; font-weight: 500; color: var(--color-navy); cursor: pointer; }
      .adm-btn:hover { background: var(--color-navy); color: #fff; text-decoration: none; }
      .adm-actions { gap: 8px; }
      .adm-actions .adm-btn { padding: 0 14px; font-size: 14px; }
      @media (min-width: 1024px) { .adm-actions { gap: 10px; } .adm-actions .adm-btn { padding: 0 20px; font-size: 15px; } }
      .adm-btn-danger { border-color: #e3b4b4; background: #fff; color: #a33; }
      .adm-btn-danger:hover { background: #fbeeee; border-color: #a33; }
      .adm-btn-primary { background: var(--color-orange); border-color: var(--color-orange); }
      .adm-btn-primary:hover { background: var(--color-orange-hover); border-color: var(--color-orange-hover); color: var(--color-navy); }
      .adm-pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; background: #e6f1fb; color: var(--color-sky-text); }
      .adm-pill-warn { background: #fdf0d8; color: #8a5a00; }
      .adm-pill-ok { background: #e1f3ea; color: #1b6b45; }
      .adm-avatar { display: grid; place-items: center; flex: none; border-radius: 9999px; background: var(--color-navy); color: #fff; font-weight: 500; }
      .adm-row { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-top: 1px solid var(--color-line); color: inherit; }
      .adm-row:first-child { border-top: 0; }
      .adm-line { display: flex; align-items: center; border-top: 1px solid var(--color-line); }
      .adm-line:first-child { border-top: 0; }
      .adm-line[hidden] { display: none; }
      .adm-line > a.adm-row { flex: 1; min-width: 0; border-top: 0; }
      .adm-move { display: flex; flex: none; gap: 4px; padding-right: 12px; }
      .adm-move button { width: 36px; height: 36px; border: 1px solid var(--color-line); border-radius: 8px; background: #fff; color: var(--color-navy); font-size: 16px; cursor: pointer; }
      .adm-move button:hover:not(:disabled) { background: var(--color-surface-soft); }
      .adm-move button:disabled { opacity: .3; cursor: default; }
      a.adm-row:hover { background: var(--color-surface-soft); text-decoration: none; }
    </style>
  </body>
</html>
