---
// Recognition list, most recent first. One consistent format for every item — splitting into
// "featured cards" + "plain list" read as two overlapping treatments of the same kind of thing.
import { featuredIn } from '../data/press';
import { getPress } from '../lib/content';

interface Props { showFeaturedIn?: boolean }
const { showFeaturedIn = true } = Astro.props;
const items = [...(await getPress())].sort((a, b) => b.date.localeCompare(a.date));
---
<div>
  <ol class="border-t border-line">
    {items.map((p) => (
      <li data-reveal class="grid grid-cols-[64px_minmax(0,1fr)] gap-3 border-b border-line py-[18px] sm:grid-cols-[minmax(84px,110px)_minmax(0,1fr)] sm:gap-5">
        <div class="pt-0.5 text-sm font-medium uppercase tracking-[0.1em] text-sky-text">{p.dateLabel}</div>
        <div>
          <div class="text-base font-medium leading-normal [text-wrap:pretty]">{p.url ? <a href={p.url}>{p.title}</a> : p.title}</div>
          <div class="mt-0.5 text-sm text-ink-muted">{p.by}</div>
        </div>
      </li>
    ))}
  </ol>

  {showFeaturedIn && featuredIn.length > 0 && (
    <div class="mt-6">
      <div class="eyebrow text-ink-muted">As featured in</div>
      <div class="mt-4 flex flex-wrap gap-x-9 gap-y-3 text-xl font-semibold uppercase tracking-[0.04em] text-ink">{featuredIn.map((m) => <span>{m}</span>)}</div>
    </div>
  )}
</div>
