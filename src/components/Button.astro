---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'navy' | 'tertiary' | 'light';
  size?: 'md' | 'sm';
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', external = false, class: cls } = Astro.props;
---
<a href={href} class:list={['btn', `btn-${variant}`, size === 'sm' && 'btn-sm', cls]} {...(external ? { target: '_blank', rel: 'noopener' } : {})}><slot /></a>
