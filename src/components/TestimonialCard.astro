---
// Testimonial tile for a grid (Home "Voices from the stage"): photo on top, quote below with
// a short orange accent, author, optional caption and the project name.
import Photo from './Photo.astro';
import type { ImageRef } from '../data/types';

interface Props { text: string; who: string; caption?: string; project?: string; photo?: ImageRef }
const { text, who, caption, project, photo } = Astro.props;
---
<figure data-reveal class="m-0 flex flex-col overflow-hidden rounded-card bg-white">
  {photo && (
    <div class="relative aspect-[16/10] bg-placeholder">
      <Photo {...photo} sizes="(min-width:1024px) 480px, 100vw" />
    </div>
  )}
  <div class="flex flex-col p-6">
    <span aria-hidden="true" class="h-1 w-8 rounded-sm bg-orange"></span>
    <blockquote class="m-0 mt-5 text-lg leading-[1.55] text-ink [text-wrap:pretty]">“{text}”</blockquote>
    <figcaption class="mt-6 text-sm font-medium uppercase tracking-[0.08em] text-sky-text">{who}</figcaption>
    {caption && <div class="mt-1 text-sm text-ink-muted">{caption}</div>}
    {project && <div class="eyebrow mt-1 text-ink-muted">{project}</div>}
  </div>
</figure>
