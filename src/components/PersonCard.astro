---
// Person tile: round portrait, name and role. Renders an empty circle when no photo exists yet.
import Photo from './Photo.astro';
import type { ImageRef } from '../data/types';

interface Props { name: string; role: string; photo?: ImageRef | null; size?: 'md' | 'lg' }
const { name, role, photo, size = 'md' } = Astro.props;
const dim = size === 'lg' ? 'h-[160px] w-[160px]' : 'h-[112px] w-[112px]';
---
<li data-reveal class="text-center">
  <div class:list={['relative mx-auto overflow-hidden rounded-full bg-placeholder', dim]}>
    {photo && <Photo {...photo} alt={photo.alt || `Portrait of ${name}`} sizes="160px" />}
  </div>
  <div class="mt-3 text-[17px] font-semibold leading-tight">{name}</div>
  <div class="mt-0.5 text-[13px] text-ink-muted">{role}</div>
</li>
