---
// Person tile. "round" (default): round portrait, name and role — used for ambassadors,
// artists and project edition line-ups. "card": rectangular photo card with city and bio —
// used for the Team & board grid.
import Photo from './Photo.astro';
import type { ImageRef } from '../data/types';

interface Props { name: string; role: string; city?: string; bio?: string; photo?: ImageRef | null; size?: 'md' | 'lg'; variant?: 'round' | 'card' }
const { name, role, city, bio, photo, size = 'md', variant = 'round' } = Astro.props;
const dim = size === 'lg' ? 'h-[160px] w-[160px]' : 'h-[112px] w-[112px]';
---
{variant === 'card' ? (
  <li data-reveal class="card-lift flex flex-col overflow-hidden rounded-card border border-line bg-white">
    {photo && (
      <div class="relative aspect-[4/3] overflow-hidden bg-placeholder">
        <Photo {...photo} alt={photo.alt || `Portrait of ${name}`} sizes="(min-width:1024px) 320px, 50vw" />
      </div>
    )}
    <div class="flex flex-1 flex-col p-5">
      <div class="text-[17px] font-semibold leading-tight text-ink">{name}</div>
      <div class="mt-1 text-sm text-sky-text">{role}</div>
      {city && <div class="eyebrow mt-1.5 text-ink-muted">{city}</div>}
      {bio && <p class="mt-3 text-sm leading-relaxed text-ink-muted">{bio}</p>}
    </div>
  </li>
) : (
  <li data-reveal class="text-center">
    {photo && (
      <div class:list={['relative mx-auto overflow-hidden rounded-full bg-placeholder', dim]}>
        <Photo {...photo} alt={photo.alt || `Portrait of ${name}`} sizes="160px" />
      </div>
    )}
    <div class:list={['text-[17px] font-semibold leading-tight', photo && 'mt-3']}>{name}</div>
    <div class="mt-0.5 text-[13px] text-ink-muted">{role}</div>
  </li>
)}
