---
// Video player. YouTube videos show their own cover picture (loaded from YouTube's image server, no cookies); the player
// itself, which is what tracks, loads only after a click. Vimeo shows a plain cover.
import { embedUrl, youtubeId } from '../lib/video';

interface Props { url: string; title?: string }
const { url, title = '' } = Astro.props;
const src = embedUrl(url);
const yt = youtubeId(url);
---
{src && (
  <div data-video data-src={src} class="relative aspect-video w-full overflow-hidden rounded-card bg-navy-deep">
    <button type="button" data-video-play aria-label={`Play video${title ? `: ${title}` : ''}`} class="group absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#1b4a7a_0%,#14365a_55%,#0d2542_100%)] p-6 text-center text-white">
      {yt && (
        <img src={`https://i.ytimg.com/vi/${yt}/maxresdefault.jpg`} alt="" loading="lazy" referrerpolicy="no-referrer"
             onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${yt}/hqdefault.jpg'`}
             class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" />
      )}
      {yt && <span class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,.65)_0%,rgba(0,0,0,0)_32%,rgba(0,0,0,.25)_100%)]"></span>}
      {yt && title && <span class="absolute left-4 right-4 top-4 truncate text-left text-base font-semibold sm:left-6 sm:top-5 sm:text-xl">{title}</span>}
      <span class="relative flex flex-col items-center gap-4">
        <span class="grid h-[72px] w-[72px] place-items-center rounded-full bg-white shadow-[0_10px_30px_rgba(0,0,0,.35)] transition-transform group-hover:scale-105">
          <span class="ml-1 h-0 w-0 border-y-[11px] border-l-[17px] border-y-transparent border-l-orange"></span>
        </span>
        {!yt && title && <span class="max-w-[520px] text-lg font-medium leading-snug">{title}</span>}
        {!yt && <span class="text-xs uppercase tracking-[0.14em] text-white/70">Plays on Vimeo</span>}
      </span>
    </button>
  </div>
)}

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-video-play]');
    if (!btn) return;
    const box = btn.closest<HTMLElement>('[data-video]')!;
    const frame = document.createElement('iframe');
    frame.src = box.dataset.src!;
    frame.title = btn.getAttribute('aria-label')?.replace('Play video', 'Video') ?? 'Video';
    frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    frame.allowFullscreen = true;
    frame.className = 'absolute inset-0 h-full w-full border-0';
    box.replaceChildren(frame);
  });
</script>
