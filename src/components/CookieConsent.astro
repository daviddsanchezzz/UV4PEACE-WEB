---
// Cookie bar + Google Analytics loader. Nothing from Google is requested and no analytics cookie is set
// until the visitor accepts. The choice lives in a first-party cookie for 6 months, then the bar asks again.
interface Props { measurementId: string }
const { measurementId } = Astro.props;
---
<div data-cookie-root data-ga-id={measurementId}>
  <div id="cookie-banner" role="dialog" aria-modal="false" aria-label="Cookies" hidden
       class="fixed inset-x-0 bottom-0 z-50 bg-navy-deep text-white shadow-[0_-8px_30px_-10px_rgba(0,0,0,.5)]">
    <div class="wrap flex flex-col gap-4 py-4 pb-[calc(1rem+env(safe-area-inset-bottom))] sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <p id="cookie-text" class="max-w-[760px] text-[15px] leading-snug text-line">We use cookies to analyse how the website is used. <a href="/cookies/" class="whitespace-nowrap text-white underline underline-offset-4 hover:text-sky">More information</a></p>
      <div class="flex flex-none gap-3">
        <button type="button" id="cookie-reject" class="inline-flex min-h-[44px] min-w-[112px] items-center justify-center rounded-full border-[1.5px] border-white/70 px-6 text-[13px] font-medium uppercase tracking-[0.12em] text-white transition-colors hover:bg-white hover:text-navy-deep">Reject</button>
        <button type="button" id="cookie-accept" class="inline-flex min-h-[44px] min-w-[112px] items-center justify-center rounded-full border-[1.5px] border-orange bg-orange px-6 text-[13px] font-medium uppercase tracking-[0.12em] text-navy transition-colors hover:border-orange-hover hover:bg-orange-hover">Accept</button>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cookie-root]');
  if (root) {
    const id = root.dataset.gaId!;
    const NAME = 'uv4p_consent';
    const banner = document.getElementById('cookie-banner')!;
    type W = Window & { dataLayer?: unknown[]; gtag?: (...a: unknown[]) => void; [k: string]: unknown };
    const w = window as unknown as W;

    const read = (): { analytics: boolean } | null => {
      const m = document.cookie.split('; ').find((c) => c.startsWith(NAME + '='));
      if (!m) return null;
      try { const v = JSON.parse(decodeURIComponent(m.slice(NAME.length + 1))); return v && v.v === 1 ? { analytics: !!v.analytics } : null; } catch { return null; }
    };
    const write = (analytics: boolean) => {
      document.cookie = `${NAME}=${encodeURIComponent(JSON.stringify({ v: 1, analytics, at: Date.now() }))}; Max-Age=15552000; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
    };

    let loaded = false;
    const load = () => {
      w[`ga-disable-${id}`] = false;
      if (loaded) { w.gtag?.('consent', 'update', { analytics_storage: 'granted' }); return; }
      loaded = true;
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () { (w.dataLayer as unknown[]).push(arguments); };
      w.gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'granted' });
      w.gtag('js', new Date());
      w.gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
      const s = document.createElement('script');
      s.async = true; s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
      document.head.appendChild(s);
    };
    // Withdrawing consent also removes the cookies Google already set.
    const unload = () => {
      w[`ga-disable-${id}`] = true;
      w.gtag?.('consent', 'update', { analytics_storage: 'denied' });
      const parts = location.hostname.split('.');
      document.cookie.split('; ').map((c) => c.split('=')[0]).filter((n) => /^(_ga(_.+)?|_gid|_gat.*)$/.test(n)).forEach((n) => {
        document.cookie = `${n}=; Max-Age=0; Path=/`;
        for (let i = 0; i < parts.length - 1; i++) document.cookie = `${n}=; Max-Age=0; Path=/; Domain=.${parts.slice(i).join('.')}`;
      });
    };

    const decide = (analytics: boolean) => { write(analytics); analytics ? load() : unload(); banner.hidden = true; };
    document.getElementById('cookie-accept')!.addEventListener('click', () => decide(true));
    document.getElementById('cookie-reject')!.addEventListener('click', () => decide(false));
    banner.addEventListener('keydown', (e) => { if (e.key === 'Escape' && read()) banner.hidden = true; });
    // Any link or button marked data-cookie-settings shows the bar again so the choice can be changed.
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-cookie-settings]')) { e.preventDefault(); banner.hidden = false; document.getElementById(read()?.analytics ? 'cookie-reject' : 'cookie-accept')!.focus(); }
    });

    const saved = read();
    if (!saved) banner.hidden = false; else if (saved.analytics) load();
  }
</script>
