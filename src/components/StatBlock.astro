---
// Stats block. variant "navy" (Home, full width) or "compact" (project page).
import { statsNote } from '../data/stats';
import { getStats } from '../lib/content';
interface Props { variant?: 'navy' | 'compact' }
const { variant = 'navy' } = Astro.props;
const stats = await getStats();
---
{variant === 'navy' ? (
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-card border border-white/15 bg-white/15 sm:grid-cols-3 lg:grid-cols-6">
    {stats.map((s) => (
      <div data-reveal class="min-w-0 bg-navy px-5 py-8">
        <div class="text-[clamp(40px,3.6vw,52px)] font-medium leading-none tracking-[-0.01em] text-sky">{s.n}</div>
        <div class="mt-3.5 text-sm leading-snug text-white lg:text-base">{s.label}</div>
      </div>
    ))}
  </div>
) : (
  <div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-px overflow-hidden rounded-card border border-line bg-line">
      {stats.map((s) => (
        <div class="bg-white px-5 py-6">
          <div class="text-[clamp(28px,2.6vw,40px)] font-medium leading-none text-sky-text">{s.n}</div>
          <div class="mt-2 text-sm leading-snug text-ink-muted">{s.label}</div>
        </div>
      ))}
    </div>
    <div class="mt-3 text-xs text-ink-muted">{statsNote}</div>
  </div>
)}
