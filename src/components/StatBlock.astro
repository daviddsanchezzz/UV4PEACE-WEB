---
// Stats block. variant "navy" (Home, full width) or "compact" (project page).
import { stats, statsNote } from '../data/stats';
interface Props { variant?: 'navy' | 'compact' }
const { variant = 'navy' } = Astro.props;
---
{variant === 'navy' ? (
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,180px),1fr))] gap-px overflow-hidden rounded-card border border-white/15 bg-white/15">
    {stats.map((s) => (
      <div data-reveal class="min-w-0 bg-navy px-5 py-8">
        <div class="text-[clamp(32px,3.6vw,52px)] font-medium leading-none tracking-[-0.01em] text-sky">{s.n}</div>
        <div class="mt-3.5 text-base leading-snug text-white">{s.label}</div>
      </div>
    ))}
  </div>
) : (
  <div>
    <div class="grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line">
      {stats.map((s) => (
        <div class="bg-white px-4 py-[18px]">
          <div class="text-[30px] font-medium leading-none text-sky-text">{s.n}</div>
          <div class="mt-1.5 text-[13px] leading-snug text-ink-muted">{s.label}</div>
        </div>
      ))}
    </div>
    <div class="mt-2 text-xs text-ink-muted">{statsNote}</div>
  </div>
)}
