---
// Page shell: the page title on top, then the content across the full width.
interface Props { title: string; class?: string }
const { title, class: cls } = Astro.props;
---
<div class:list={['wrap py-[clamp(40px,6vw,80px)]', cls]}>
  <h1 class="eyebrow mb-[clamp(28px,4vw,48px)] flex items-center gap-3 font-semibold text-navy"><span class="h-0.5 w-8 bg-orange"></span>{title}</h1>
  <slot />
</div>
