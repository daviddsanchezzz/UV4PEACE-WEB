---
// Partner logos in a slow loop, one per partner, from the admin (Partners section). The old site's
// hotlinked logo set was dropped because it repeated partners. Eager loading avoids gaps on iOS.
import { getPartners } from '../../lib/content';
const recent = (await getPartners()).filter((p) => p.active && p.logo).sort((a, b) => a.order - b.order).map((p) => ({ src: p.logo as string, alt: p.name }));
const logos = [...new Map(recent.map((l) => [l.src, l])).values()];
---
<div class="overflow-hidden py-4" aria-label={recent.map((r) => r.alt).join(', ') || 'Partners'}>
  <div class="marquee">
    {[...logos, ...logos].map((l, i) => (
      <span class="inline-flex h-20 w-40 flex-none items-center justify-center px-5 lg:h-24 lg:w-48" aria-hidden="true">
        <img src={l.src} alt="" loading="eager" decoding="async" class="max-h-full max-w-full object-contain" />
      </span>
    ))}
  </div>
</div>
