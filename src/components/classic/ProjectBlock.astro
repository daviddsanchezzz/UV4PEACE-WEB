---
import { Image } from 'astro:assets';
import Rich from './Rich.astro';
import type { ClassicProject } from '../../data/classic';
import gwim2026 from '../../assets/posters/gwim-2026.png';
import gwim2025 from '../../assets/posters/gwim-2025.png';
import gwim2023 from '../../assets/posters/gwim-2023.png';
import doc from '../../assets/posters/gwim-documentary.png';
interface Props { project: ClassicProject; level?: 'h2' | 'h3'; flip?: boolean }
const { project: p, level: H = 'h2', flip = false } = Astro.props;
// YouTube links in the text are also shown as embedded players.
const yt = [...new Set(p.paragraphs.join(' ').match(/(?:youtu\.be\/|youtube\.com\/(?:live\/|watch\?v=|embed\/))[\w-]{11}/g)?.map((m) => m.slice(-11)) ?? [])];
// The embedded player replaces the "Watch …: link" lines, so those links are dropped from the text.
const ytLink = /\s*(?:\*\*)?(?:Watch[^:*\[]*|Learn more on\s*)?(?:\*\*)?\s*:?\s*\[[^\]]*\]\(https?:\/\/(?:www\.)?(?:youtu\.be|youtube\.com)\/[^)]*\)/g;
const text = p.paragraphs.map((t) => { const c = t.replace(ytLink, '').trim(); return c !== t.trim() && c && !/[.!?)”*]$/.test(c) ? c + '.' : c; }).filter((t) => t && t !== '.');
const hasMedia = !!(p.photo || p.image || p.images?.length || p.video || yt.length);
const photos = { 'gwim-2026': gwim2026, 'gwim-2025': gwim2025, 'gwim-2023': gwim2023, doc };
const isPoster = !!p.photo;
// With a poster or photo beside the text, the players go under the text so both columns stay balanced.
const ytInText = yt.length > 0 && !!(p.photo || p.image || p.images?.length || p.video);
---
<article id={p.id} class="scroll-mt-24 border-t border-line pt-12 first:border-t-0 first:pt-0">
  <div class:list={['grid gap-8', hasMedia && 'lg:grid-cols-2 lg:items-start lg:gap-14']}>
    {hasMedia && (
      <div class:list={['flex min-w-0 flex-col gap-6', flip && 'lg:order-2']}>
        {p.photo && <Image src={photos[p.photo]} alt={isPoster ? `${p.title} poster` : ""} widths={isPoster ? [560, 768] : [640, 1100]} sizes="(min-width: 1024px) 50vw, 100vw" class:list={['w-full rounded-card', isPoster ? 'mx-auto max-w-[560px] border border-line' : 'aspect-[4/3] object-cover']} />}
        {p.image && <img src={p.image} alt="" loading="lazy" class="w-full rounded-card border border-line" />}
        {p.images?.map((src) => <img src={src} alt="" loading="lazy" class="w-full rounded-card border border-line" />)}
        {!ytInText && yt.map((id) => <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title={p.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen class="mx-auto aspect-video w-full max-w-[560px] rounded-card bg-navy"></iframe>)}
        {p.video && <video src={p.video} controls preload="metadata" playsinline class="aspect-video w-full rounded-card bg-navy"></video>}
      </div>
    )}
    <div class:list={['min-w-0', !hasMedia && 'max-w-[980px]']}>
      <H class="t-h2 text-navy">{p.title}</H>
      <div class="body mt-5 flex flex-col gap-4 text-ink [overflow-wrap:anywhere]">
        {text.map((t, i) => (
          <>
            {p.stats && i === text.length - 1 && (
              <section class="my-2 rounded-card bg-surface-soft p-5 sm:p-6" aria-label={p.stats.title}>
                <h4 class="text-sm font-semibold uppercase tracking-[0.08em] text-navy">{p.stats.title}</h4>
                <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
                  {p.stats.items.map((s) => (
                    <div class="flex flex-col">
                      <dt class="order-2 mt-1 text-sm leading-snug text-ink">{s.label}</dt>
                      <dd class="order-1 text-3xl font-medium leading-none text-orange">{s.value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}
            <Rich text={t} class="whitespace-pre-line" />
          </>
        ))}
      </div>
      {ytInText && <div class="mt-8 flex flex-col gap-6">{yt.map((id) => <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title={p.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen class="aspect-video w-full max-w-[560px] rounded-card bg-navy"></iframe>)}</div>}
    </div>
  </div>
</article>
