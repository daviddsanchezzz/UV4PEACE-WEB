---
import { Image } from 'astro:assets';
import Rich from './Rich.astro';
import type { ClassicProject } from '../../data/classic';
import gwim2026 from '../../assets/fotos/02-gwim-destacado-directora_IMG_5349.jpg';
import gwim2025 from '../../assets/fotos/01-hero-saludo-final_IMG_5460.jpg';
import doc from '../../assets/fotos/10-propose-partitura_IMG_5272.jpg';
interface Props { project: ClassicProject; level?: 'h2' | 'h3' }
const { project: p, level: H = 'h2' } = Astro.props;
const photos = { 'gwim-2026': gwim2026, 'gwim-2025': gwim2025, doc };
---
<article id={p.id} class="scroll-mt-24 border-t border-line pt-10 first:border-t-0 first:pt-0">
  <H class="t-h2 text-navy">{p.title}</H>
  {p.photo && <Image src={photos[p.photo]} alt="" widths={[640, 1100]} sizes="(min-width: 1024px) 760px, 100vw" class="mt-6 aspect-[16/9] w-full rounded-card object-cover" />}
  {p.image && <img src={p.image} alt="" loading="lazy" class="mt-6 w-full rounded-card border border-line" />}
  {p.video && <video src={p.video} controls preload="metadata" playsinline class="mt-6 aspect-video w-full rounded-card bg-navy"></video>}
  <div class="body mt-6 flex flex-col gap-4 text-ink [&_a]:break-words">
    {p.paragraphs.map((t) => <Rich text={t} />)}
  </div>
</article>
