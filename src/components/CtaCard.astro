---
// Small CTA card used in "Get involved": photo, title, one line and a button.
import Photo from './Photo.astro';
import Button from './Button.astro';
import type { ImageRef } from '../data/types';

interface Props { title: string; line: string; cta: string; href: string; photo: ImageRef; note?: string }
const { title, line, cta, href, photo, note } = Astro.props;
---
<article data-reveal class="card-lift flex flex-col overflow-hidden rounded-card border border-line bg-white">
  <div class="relative aspect-[16/10] bg-placeholder"><Photo {...photo} sizes="(min-width:1024px) 420px, 100vw" /></div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="t-h3">{title}</h3>
    <p class="mt-2 flex-1 text-base leading-relaxed text-ink-muted">{line}</p>
    {note && <div class="mt-3.5 text-[13px] font-medium text-sky-text">{note}</div>}
    <Button href={href} variant="tertiary" size="sm" class="mt-5 self-start">{cta}</Button>
  </div>
</article>
