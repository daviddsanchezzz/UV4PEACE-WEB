---
// Small CTA card used in "Get involved": numbered photo, uppercase title, one line and a text link.
import Photo from './Photo.astro';
import type { ImageRef } from '../data/types';

interface Props { title: string; line: string; cta: string; href: string; photo: ImageRef; note?: string; index?: number }
const { title, line, cta, href, photo, note, index } = Astro.props;
---
<article data-reveal class="card-lift flex flex-col overflow-hidden rounded-card border border-line bg-surface-soft">
  <div class="relative aspect-[16/10] bg-placeholder">
    <Photo {...photo} sizes="(min-width:1024px) 420px, 100vw" />
    {index && <span class="absolute left-3.5 top-3.5 flex h-7 w-7 items-center justify-center rounded-full bg-white text-xs font-semibold text-navy">{String(index).padStart(2, '0')}</span>}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-base font-semibold uppercase tracking-[0.04em] text-ink">{title}</h3>
    <p class="mt-2 flex-1 text-base leading-relaxed text-ink-muted">{line}</p>
    {note && <div class="mt-3.5 text-[13px] font-medium text-sky-text">{note}</div>}
    <a href={href} class="mt-5 inline-flex items-center gap-1.5 self-start text-sm font-medium uppercase tracking-[0.1em] text-sky-text hover:text-navy">{cta} <span aria-hidden="true">→</span></a>
  </div>
</article>
