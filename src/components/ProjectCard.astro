---
import Photo from './Photo.astro';
import { statusLabel, type Project } from '../data/projects';

interface Props { project: Project }
const { project: p } = Astro.props;
const editionCount = p.editions?.filter((e) => !e.upcoming).length ?? 0;
---
<a href={`/projects/${p.slug}/`} data-reveal data-status={p.status} class="card-lift flex flex-col rounded-card bg-white text-ink hover:text-ink hover:no-underline">
  <div class="relative aspect-[4/3] overflow-hidden rounded-card bg-placeholder">
    {p.cover
      ? <Photo {...p.cover} sizes="(min-width:1024px) 420px, 100vw" />
      : (
        <div aria-hidden="true" class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#1b4a7a_0%,#14365a_55%,#0d2542_100%)]">
          <img src="/logos/uv4peace-globo-white.svg" alt="" class="h-[46%] w-auto opacity-[.14]" />
          {p.yearStart && <span class="absolute bottom-4 right-5 text-[clamp(28px,3vw,40px)] font-light leading-none tracking-[0.04em] text-white/70">{p.yearStart.slice(0, 4)}</span>}
        </div>
      )}
    <div class="absolute left-3.5 top-3.5 flex gap-1.5">
      <span class:list={['chip', p.status === 'ongoing' ? 'bg-orange' : 'bg-white']}>{statusLabel[p.status]}</span>
      {editionCount > 1 && <span class="chip bg-navy text-white">{editionCount} editions</span>}
    </div>
  </div>
  <div class="px-1 pb-2 pt-5">
    <div class="eyebrow text-sky-text">{p.dateLabel} · {p.city}</div>
    <h3 class="t-h3 mt-2.5">{p.title}</h3>
    <p class="mt-2 text-base leading-relaxed text-ink-muted">{p.summary}</p>
  </div>
</a>
