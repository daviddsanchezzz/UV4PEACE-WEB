---
// Optimised photo (webp, srcset) from src/assets/fotos/<name>, or a plain <img> for a full
// https:// URL (board portraits still hosted on the current uv4peace.org site).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png}', { eager: true });

interface Props { src: string; alt: string; pos?: string; class?: string; sizes?: string; loading?: 'eager' | 'lazy' }
const { src, alt, pos = '50% 50%', class: cls = 'absolute inset-0 h-full w-full object-cover', sizes = '100vw', loading = 'lazy' } = Astro.props;
const isRemote = /^https?:\/\//.test(src);
const mod = isRemote ? null : photos[`../assets/fotos/${src}`];
if (!isRemote && !mod) throw new Error(`Photo not found in src/assets/fotos: ${src}`);
---
{isRemote
  ? <img src={src} alt={alt} loading={loading} class={cls} style={`object-position:${pos}`} />
  : <Image src={mod!.default} alt={alt} widths={[480, 800, 1200, 1600, 2400]} sizes={sizes} loading={loading} class={cls} style={`object-position:${pos}`} />}
