---
// Full media coverage list, real outlets pulled from the live uv4peace.org Media Room.
import { spokeAboutUs, mediaCoverage, pressArchive, languageLabel, type Language } from '../data/press';

const languages: Language[] = ['en', 'es', 'fr', 'it', 'ar'];
const groups = languages
  .map((lang) => ({ lang, items: mediaCoverage.filter((m) => m.language === lang) }))
  .filter((g) => g.items.length > 0)
  .sort((a, b) => b.items.length - a.items.length);
---
<div>
  <div class="eyebrow text-ink-muted">Spoke about us</div>
  <p class="mt-2 text-base"><a href={spokeAboutUs.url} target="_blank" rel="noopener">{spokeAboutUs.outlet}</a></p>

  <div class="eyebrow mt-10 text-ink-muted">Media coverage</div>
  <div class="mt-5 columns-1 gap-x-10 sm:columns-2 lg:columns-4">
    {groups.map((g) => (
      <div class="mb-8 break-inside-avoid">
        <div class="text-sm font-semibold uppercase tracking-[0.08em] text-sky-text">{languageLabel[g.lang]}</div>
        <ul class="mt-3 flex flex-col gap-2">
          {g.items.map((m) => (
            <li>
              {m.url
                ? <a href={m.url} target="_blank" rel="noopener" class="text-base">{m.outlet}</a>
                : <span class="text-base text-ink-muted">{m.outlet} <span class="pending">(link coming soon)</span></span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {pressArchive.length > 0 && (
    <div class="mt-10">
      <div class="eyebrow text-ink-muted">Earlier coverage</div>
      <ol class="mt-3 border-t border-line">
        {pressArchive.map((item) => (
          <li class="grid grid-cols-[minmax(84px,110px)_minmax(0,1fr)] gap-5 border-b border-line py-3.5">
            <div class="pt-0.5 text-sm font-medium uppercase tracking-[0.1em] text-sky-text">{item.date || '—'}</div>
            <div class="text-base leading-normal">
              {item.title}
              {item.links.map((l, i) => (
                <>
                  {' '}{i === 0 ? '— ' : '· '}
                  {l.url ? <a href={l.url} target="_blank" rel="noopener">{l.label}</a> : <span class="text-ink-muted">{l.label}</span>}
                </>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
  )}
</div>
