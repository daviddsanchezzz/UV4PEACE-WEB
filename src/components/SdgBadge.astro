---
// Official UN SDG icon tile. Source: WEB CLAUDE DESING/uploads/UV4PEACE-claude-design/sdg/.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/sdg/*.png', { eager: true });

interface Props { n: number; label: string }
const { n, label } = Astro.props;
const mod = icons[`../assets/sdg/sdg-${String(n).padStart(2, '0')}.png`];
if (!mod) throw new Error(`SDG icon not found for goal ${n}`);
---
<Image src={mod.default} alt={`UN Sustainable Development Goal ${n}: ${label}`} widths={[96, 144, 192, 288, 384]} sizes="(min-width: 640px) 96px, 72px" quality={90} class="h-[72px] w-[72px] rounded-md sm:h-24 sm:w-24" />
