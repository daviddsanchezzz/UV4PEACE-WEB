---
// Project grid with an All / Ongoing / Archive filter. The "heading" slot sits left of the tabs.
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

interface Props { projects: Project[] }
const { projects } = Astro.props;
const tabs = [{ f: 'all', label: 'All' }, { f: 'ongoing', label: 'Ongoing' }, { f: 'past', label: 'Archive' }];
---
<div data-project-filter>
  <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
    <div><slot name="heading" /></div>
    <div role="tablist" aria-label="Filter projects" class="tabs flex gap-1.5 rounded-full border border-line p-1.5">
      {tabs.map((t, i) => (
        <button type="button" role="tab" data-filter={t.f} aria-selected={i === 0 ? 'true' : 'false'} class="cursor-pointer rounded-full px-[18px] py-2.5 text-[13px] font-medium uppercase tracking-[0.14em]">{t.label}</button>
      ))}
    </div>
  </div>
  <div class="mt-12 grid grid-cols-[repeat(auto-fill,minmax(min(100%,340px),1fr))] gap-[clamp(20px,2.4vw,32px)]">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-filter]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = root.querySelectorAll<HTMLElement>('[data-status]');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const f = tab.dataset.filter;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      cards.forEach((c) => { const ok = f === 'all' || c.dataset.status === f; c.hidden = !ok; if (ok) c.classList.add('is-in'); });
    }));
  });
</script>
